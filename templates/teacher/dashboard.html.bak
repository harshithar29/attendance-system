{% extends "base.html" %}

{% block title %}
Teacher Dashboard - GSSS Attendance Portal
{% endblock %}

{% block body_class %}teacher-dashboard-page{% endblock %}

{% block navbar %}{% endblock %}
{% block footer %}{% endblock %}

{% block extra_css %}
<style>
/* =========================================================
   GLOBAL RESET FOR TEACHER DASHBOARD
========================================================= */
.teacher-dashboard-page {
    background: #f8fafc;
    color: #1e293b;
    font-family: 'Poppins', sans-serif;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
}

.teacher-dashboard-page .portal-navbar,
.teacher-dashboard-page .portal-footer {
    display: none !important;
}

.teacher-dashboard-page .portal-main {
    padding: 0 !important;
    margin: 0 !important;
    min-height: 100vh;
    width: 100%;
}

.teacher-dashboard-page .portal-main > .container-fluid {
    padding: 0 !important;
    margin: 0 !important;
    max-width: 100% !important;
    width: 100% !important;
}

/* Floating Flash Alert */
.teacher-dashboard-page .flash-container {
    position: fixed;
    top: 24px;
    right: 28px;
    z-index: 10500;
    max-width: 460px;
    width: calc(100% - 56px);
    pointer-events: auto;
}

.teacher-dashboard-page .portal-alert {
    border-radius: 14px;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.14);
    border: none;
    font-size: 0.9rem;
    padding: 14px 20px;
    backdrop-filter: blur(10px);
}

/* =========================================================
   MAIN LAYOUT (FLEX CONTAINER)
========================================================= */
.teacher-layout {
    display: flex;
    min-height: 100vh;
    width: 100%;
    background: #f8fafc;
}

/* =========================================================
   SIDEBAR
========================================================= */
.teacher-sidebar {
    width: 270px;
    min-width: 270px;
    height: 100vh;
    background: #ffffff;
    border-right: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 4px 0 24px rgba(15, 23, 42, 0.03);
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    left: 0;
    z-index: 1000;
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
}

.teacher-brand {
    padding: 24px 20px;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 12px;
}

.teacher-brand-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #8EC5FC, #E0C3FC);
    color: #0f172a;
    font-size: 1.25rem;
    box-shadow: 0 6px 16px rgba(142, 197, 252, 0.35);
    flex-shrink: 0;
}

.teacher-brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
}

.teacher-brand-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.01em;
}

.teacher-brand-subtitle {
    font-size: 0.72rem;
    color: #64748b;
    font-weight: 500;
}

.teacher-menu {
    padding: 18px 14px;
    flex: 1;
    overflow-y: auto;
}

.menu-heading {
    font-size: 0.68rem;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0 12px;
    margin-bottom: 8px;
    margin-top: 14px;
}

.menu-heading:first-child {
    margin-top: 0;
}

.teacher-menu-link {
    width: 100%;
    border: none;
    background: transparent;
    color: #475569;
    text-decoration: none;
    padding: 11px 14px;
    margin-bottom: 4px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.88rem;
    font-weight: 500;
    transition: all 0.2s ease;
    cursor: pointer;
    text-align: left;
}

.teacher-menu-link i {
    width: 22px;
    font-size: 1.1rem;
    text-align: center;
    color: #64748b;
    transition: color 0.2s ease;
}

.teacher-menu-link:hover {
    background: rgba(142, 197, 252, 0.16);
    color: #0f172a;
    transform: translateX(3px);
}

.teacher-menu-link:hover i {
    color: #2563eb;
}

.teacher-menu-link.active {
    background: linear-gradient(135deg, rgba(142, 197, 252, 0.32), rgba(224, 195, 252, 0.32));
    color: #0f172a;
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(142, 197, 252, 0.20);
}

.teacher-menu-link.active i {
    color: #1d4ed8;
}

.teacher-sidebar-bottom {
    padding: 16px 14px;
    border-top: 1px solid #f1f5f9;
    background: #ffffff;
}

.teacher-user-card {
    padding: 10px 12px;
    margin-bottom: 10px;
    border-radius: 12px;
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 12px;
}

.teacher-avatar {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #B8F2E6, #8EC5FC);
    color: #0f172a;
    font-size: 1.1rem;
    flex-shrink: 0;
}

.teacher-user-name {
    font-size: 0.85rem;
    font-weight: 700;
    color: #0f172a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 140px;
}

.teacher-user-role {
    font-size: 0.7rem;
    color: #64748b;
}

.teacher-logout {
    color: #dc2626;
}

.teacher-logout:hover {
    background: #fef2f2;
    color: #b91c1c;
}

.teacher-logout i {
    color: #dc2626;
}

/* Sidebar Backdrop on Mobile */
.sidebar-backdrop {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(15, 23, 42, 0.4);
    backdrop-filter: blur(4px);
    z-index: 999;
}

.sidebar-backdrop.active {
    display: block;
}

/* =========================================================
   MAIN CONTENT AREA
========================================================= */
.teacher-content {
    flex: 1;
    min-width: 0;
    padding: 32px 40px 60px;
    background: #f8fafc;
    overflow-y: auto;
}

/* =========================================================
   TOPBAR
========================================================= */
.teacher-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
    gap: 20px;
}

.teacher-page-title {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
}

.teacher-page-subtitle {
    margin: 4px 0 0;
    color: #64748b;
    font-size: 0.88rem;
}

.teacher-date {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 12px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #475569;
    font-size: 0.82rem;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
    white-space: nowrap;
}

.mobile-sidebar-button {
    display: none;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    color: #0f172a;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
}

/* =========================================================
   STATS GRID
========================================================= */
.teacher-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 28px;
}

.teacher-stat-card {
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 18px;
    padding: 22px;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.teacher-stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
}

.stat-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: #64748b;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.stat-number {
    font-size: 1.85rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1;
}

.stat-icon {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
}

.stat-blue { background: rgba(142, 197, 252, 0.30); color: #0284c7; }
.stat-green { background: rgba(184, 242, 230, 0.45); color: #059669; }
.stat-purple { background: rgba(224, 195, 252, 0.40); color: #7c3aed; }
.stat-orange { background: rgba(254, 215, 170, 0.50); color: #d97706; }

/* =========================================================
   CARDS
========================================================= */
.teacher-card {
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 20px;
    box-shadow: 0 6px 24px rgba(15, 23, 42, 0.03);
    overflow: hidden;
    margin-bottom: 26px;
}

.teacher-card-header {
    padding: 20px 26px;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff;
}

.teacher-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
    display: flex;
    align-items: center;
}

.teacher-card-subtitle {
    font-size: 0.78rem;
    color: #64748b;
    margin-top: 4px;
}

.teacher-card-body {
    padding: 26px;
}

/* =========================================================
   UPLOAD CARD & FORMS
========================================================= */
.upload-heading {
    display: flex;
    align-items: center;
    gap: 14px;
}

.upload-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #8EC5FC, #E0C3FC);
    color: #0f172a;
    font-size: 1.25rem;
}

.form-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: #334155;
    margin-bottom: 7px;
}

.teacher-form-control {
    height: 46px;
    border-radius: 11px;
    border: 1px solid #cbd5e1;
    font-size: 0.86rem;
    padding: 10px 14px;
    color: #1e293b;
    background-color: #ffffff;
    transition: all 0.2s ease;
}

.teacher-form-control:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(147, 197, 253, 0.25);
    background-color: #ffffff;
}

.upload-button {
    height: 46px;
    border: none;
    border-radius: 11px;
    padding: 0 28px;
    font-size: 0.88rem;
    font-weight: 700;
    background: linear-gradient(135deg, #8EC5FC, #E0C3FC);
    color: #0f172a;
    box-shadow: 0 6px 18px rgba(142, 197, 252, 0.35);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.upload-button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(142, 197, 252, 0.45);
}

.upload-button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
}

.video-info {
    margin-top: 18px;
    padding: 12px 16px;
    border-radius: 11px;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    font-size: 0.82rem;
    color: #334155;
}

/* =========================================================
   TABLES & BADGES
========================================================= */
.attendance-table-wrap {
    width: 100%;
    overflow-x: auto;
    border-radius: 14px;
    border: 1px solid #e2e8f0;
}

.attendance-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
    margin: 0;
}

.attendance-table th {
    background: #f8fafc;
    color: #475569;
    font-weight: 600;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 14px 18px;
    border-bottom: 2px solid #e2e8f0;
    white-space: nowrap;
    vertical-align: middle;
}

.attendance-table td {
    padding: 13px 18px;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
    vertical-align: middle;
    white-space: nowrap;
}

.attendance-table tbody tr:hover td {
    background: #f8fafc;
}

.attendance-table tbody tr:last-child td {
    border-bottom: none;
}

/* Status Badges */
.status-present {
    background: #dcfce7;
    color: #15803d;
    padding: 4px 12px;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.78rem;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

.status-absent {
    background: #fee2e2;
    color: #b91c1c;
    padding: 4px 12px;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.78rem;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

.status-unknown {
    background: #fef3c7;
    color: #b45309;
    padding: 4px 12px;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.78rem;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

.latest-video-badge {
    background: linear-gradient(135deg, #8EC5FC, #E0C3FC);
    color: #0f172a;
    padding: 3px 12px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
}

.latest-video-time {
    font-size: 0.78rem;
    color: #64748b;
    font-weight: 500;
}

/* =========================================================
   FILTERS SECTION
========================================================= */
.filter-section {
    background: #f8fafc;
    padding: 18px 22px;
    border-radius: 14px;
    margin-bottom: 22px;
    border: 1px solid #e2e8f0;
}

.filter-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: #475569;
    margin-bottom: 6px;
    display: block;
}

.filter-select, .filter-input {
    height: 42px;
    border-radius: 10px;
    border: 1px solid #cbd5e1;
    font-size: 0.84rem;
    padding: 8px 14px;
    width: 100%;
    color: #1e293b;
    background-color: #ffffff;
}

.filter-select:focus, .filter-input:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(147, 197, 253, 0.25);
}

/* =========================================================
   EMPTY STATE
========================================================= */
.activity-empty {
    padding: 45px 20px;
    text-align: center;
    color: #64748b;
}

.activity-empty i {
    font-size: 2.8rem;
    color: #94a3b8;
    margin-bottom: 12px;
    display: block;
}

.activity-empty p {
    font-size: 0.88rem;
    margin: 0;
}

/* =========================================================
   RESPONSIVE DESIGN & ALIGNMENT
========================================================= */
@media (max-width: 1200px) {
    .teacher-stats {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 992px) {
    .teacher-sidebar {
        position: fixed;
        left: 0;
        top: 0;
        height: 100vh;
        transform: translateX(-100%);
        z-index: 1001;
    }

    .teacher-sidebar.open {
        transform: translateX(0);
    }

    .mobile-sidebar-button {
        display: flex;
    }

    .teacher-content {
        padding: 24px 20px 40px;
    }
}

@media (max-width: 600px) {
    .teacher-stats {
        grid-template-columns: 1fr;
    }

    .teacher-topbar {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }

    .teacher-date {
        align-self: flex-start;
    }

    .teacher-card-header {
        flex-direction: column;
        gap: 10px;
    }
}

/* =========================================================
   STUDENTS SECTION & PROGRESS BARS
========================================================= */
.attendance-progress {
    width: 110px;
    height: 8px;
    background-color: #e2e8f0;
    border-radius: 999px;
    overflow: hidden;
    display: inline-block;
    vertical-align: middle;
    margin-right: 8px;
}

.attendance-progress-bar {
    height: 100%;
    border-radius: 999px;
    transition: width 0.4s ease;
}

.bg-progress-good { background-color: #10b981; }
.bg-progress-avg { background-color: #f59e0b; }
.bg-progress-low { background-color: #ef4444; }

/* =========================================================
   AI ANALYSIS CARDS & METRICS
========================================================= */
.ai-summary-card {
    background: linear-gradient(135deg, rgba(240, 249, 255, 0.95), rgba(245, 243, 255, 0.95));
    border: 1px solid #c7d2fe;
    border-radius: 16px;
    padding: 22px 24px;
    margin-bottom: 24px;
}

.ai-badge-glow {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #ffffff;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 5px 14px;
    border-radius: 30px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
}

.ai-recommendation-item {
    background: #ffffff;
    border: 1px solid #e0e7ff;
    border-radius: 12px;
    padding: 14px 18px;
    margin-bottom: 10px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-size: 0.88rem;
    color: #1e293b;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.ai-recommendation-item:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
}

.ai-rec-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #eef2ff;
    color: #4f46e5;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 1rem;
}

/* =========================================================
   ANALYTICS CHART WRAPPERS
========================================================= */
.chart-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 20px 22px;
    height: 100%;
    display: flex;
    flex-column: column;
}

.chart-title {
    font-size: 0.94rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.chart-subtitle {
    font-size: 0.78rem;
    color: #64748b;
    margin-bottom: 16px;
}

.chart-wrapper {
    position: relative;
    width: 100%;
    min-height: 250px;
    max-height: 320px;
    flex: 1;
}

/* =========================================================
   AI INTELLIGENCE FEATURE CARDS & MODALS
========================================================= */
.ai-feature-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 22px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.ai-feature-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px -6px rgba(15, 23, 42, 0.08);
    border-color: #cbd5e1;
}

.ai-feature-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 12px;
}

.ai-feature-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
}

.icon-blue { background: #eff6ff; color: #2563eb; }
.icon-green { background: #ecfdf5; color: #059669; }
.icon-cyan { background: #ecfeff; color: #0891b2; }
.icon-amber { background: #fffbeb; color: #d97706; }
.icon-dark { background: #f1f5f9; color: #1e293b; }
.icon-rose { background: #fff1f2; color: #e11d48; }
.icon-purple { background: #f5f3ff; color: #7c3aed; }
.icon-teal { background: #f0fdfa; color: #0d9488; }

.ai-feature-badge {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

.ai-feature-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 4px;
}

.ai-feature-body {
    flex: 1;
    margin-bottom: 16px;
}

.ai-feature-metric {
    font-size: 1.28rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 10px;
    line-height: 1.25;
}

.ai-detail-row {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
    font-size: 0.81rem;
    color: #475569;
    border-bottom: 1px dashed #f1f5f9;
}

.ai-detail-row:last-child {
    border-bottom: none;
}

.ai-detail-label {
    color: #64748b;
}

.ai-detail-val {
    font-weight: 600;
    color: #1e293b;
}

.ai-modal-header {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    border-top-left-radius: calc(14px - 1px);
    border-top-right-radius: calc(14px - 1px);
    padding: 16px 22px;
}
</style>
{% endblock %}

{% block content %}
<div class="teacher-layout">

    <!-- SIDEBAR BACKDROP FOR MOBILE -->
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- =====================================================
         SIDEBAR
    ====================================================== -->
    <aside class="teacher-sidebar" id="teacherSidebar">

        <!-- BRAND -->
        <div class="teacher-brand">
            <div class="teacher-brand-icon">
                <i class="bi bi-camera-video-fill"></i>
            </div>
            <div class="teacher-brand-text">
                <div class="teacher-brand-title">GSSS Attendance</div>
                <div class="teacher-brand-subtitle">Teacher Portal</div>
            </div>
        </div>

        <!-- MENU -->
        <div class="teacher-menu">
            <div class="menu-heading">Main</div>

            <button type="button" class="teacher-menu-link active" data-section="dashboardSection">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </button>

            <button type="button" class="teacher-menu-link" data-section="studentsSection">
                <i class="bi bi-people-fill"></i>
                <span>Students</span>
            </button>

            <button type="button" class="teacher-menu-link" data-section="verificationSection">
                <i class="bi bi-check2-circle"></i>
                <span>Manual Verification</span>
            </button>

            <div class="menu-heading">Intelligence &amp; Analytics</div>

            <button type="button" class="teacher-menu-link" data-section="aiAnalysisSection">
                <i class="bi bi-cpu-fill"></i>
                <span>AI Analysis</span>
            </button>

            <button type="button" class="teacher-menu-link" data-section="analyticsSection">
                <i class="bi bi-bar-chart-fill"></i>
                <span>Attendance Analytics</span>
            </button>

            <button type="button" class="teacher-menu-link" data-section="historySection">
                <i class="bi bi-clock-history"></i>
                <span>Attendance History</span>
            </button>

            <button type="button" class="teacher-menu-link" data-section="processingHistorySection">
                <i class="bi bi-camera-reels-fill"></i>
                <span>Processing History</span>
            </button>

            <div class="menu-heading">Export &amp; Communication</div>

            <button type="button" class="teacher-menu-link" data-section="exportSection">
                <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                <span>Excel / PDF Reports</span>
            </button>

            <button type="button" class="teacher-menu-link" data-section="emailSection">
                <i class="bi bi-envelope-at-fill"></i>
                <span>Email Reports</span>
            </button>

            <button type="button" class="teacher-menu-link" data-section="notificationsSection">
                <i class="bi bi-bell-fill"></i>
                <span>Notifications</span>
                <span class="badge bg-danger rounded-pill ms-auto small" id="sidebarNotifBadge">4</span>
            </button>

            <div class="menu-heading">System</div>

            <button type="button" class="teacher-menu-link" data-section="profileSection">
                <i class="bi bi-person-circle"></i>
                <span>Teacher Profile</span>
            </button>
        </div>

        <!-- SIDEBAR BOTTOM -->
        <div class="teacher-sidebar-bottom">
            <div class="teacher-user-card">
                <div class="teacher-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div>
                    <div class="teacher-user-name">
                        {{ name or session.get('name') or 'Teacher' }}
                    </div>
                    <div class="teacher-user-role">Teacher</div>
                </div>
            </div>
            <a href="{{ url_for('auth.logout') }}" class="teacher-menu-link teacher-logout">
                <i class="bi bi-box-arrow-right"></i>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->
    <main class="teacher-content">

        <!-- TOP BAR -->
        <div class="teacher-topbar">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="mobile-sidebar-button" id="mobileSidebarButton" aria-label="Toggle Menu">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div>
                    <h1 class="teacher-page-title" id="pageTitle">Dashboard</h1>
                    <p class="teacher-page-subtitle" id="pageSubtitle">
                        Welcome, {{ name or session.get('name') or 'Teacher' }}. Manage classroom video attendance and student records.
                    </p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-light position-relative border" id="topbarNotifBtn" title="Notification Center" onclick="openNotificationsTab()" style="border-radius: 10px; padding: 7px 12px;">
                    <i class="bi bi-bell-fill text-primary"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="topbarNotifBadge" style="font-size: 0.68rem;">
                        4
                    </span>
                </button>
                <div class="teacher-date">
                    <i class="bi bi-calendar3 text-primary"></i>
                    <span id="currentDate">Today</span>
                </div>
            </div>
        </div>

        <!-- UPLOAD STATUS ALERT (DYNAMIC) -->
        <div id="uploadStatus" class="alert d-none"></div>

        <!-- =================================================
             1. DASHBOARD SECTION (DEFAULT)
        ================================================== -->
        <section id="dashboardSection" class="dashboard-section">

            <!-- STAT CARDS -->
            <div class="teacher-stats">
                <div class="teacher-stat-card">
                    <div>
                        <div class="stat-label">Total Students</div>
                        <div class="stat-number">{{ stats.total_students if stats else 0 }}</div>
                    </div>
                    <div class="stat-icon stat-blue">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>

                <div class="teacher-stat-card">
                    <div>
                        <div class="stat-label">Present Today</div>
                        <div class="stat-number" style="color: #059669;">
                            {% if attendance_data and attendance_data|length > 0 %}
                                {{ attendance_data|selectattr('status', 'equalto', 'present')|list|length }}
                            {% else %}
                                0
                            {% endif %}
                        </div>
                    </div>
                    <div class="stat-icon stat-green">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                </div>

                <div class="teacher-stat-card">
                    <div>
                        <div class="stat-label">Absent Today</div>
                        <div class="stat-number" style="color: #dc2626;">
                            {% if attendance_data and attendance_data|length > 0 %}
                                {% set total = stats.total_students if stats else 0 %}
                                {% set present_count = attendance_data|selectattr('status', 'equalto', 'present')|list|length %}
                                {{ total - present_count if total >= present_count else 0 }}
                            {% else %}
                                {{ stats.total_students if stats else 0 }}
                            {% endif %}
                        </div>
                    </div>
                    <div class="stat-icon stat-purple">
                        <i class="bi bi-person-x-fill"></i>
                    </div>
                </div>

                <div class="teacher-stat-card">
                    <div>
                        <div class="stat-label">Videos Processed</div>
                        <div class="stat-number">{{ stats.videos_processed if stats else 0 }}</div>
                    </div>
                    <div class="stat-icon stat-orange">
                        <i class="bi bi-camera-video-fill"></i>
                    </div>
                </div>
            </div>

            <!-- UPLOAD VIDEO CARD -->
            <div class="teacher-card" id="uploadSectionCard">
                <div class="teacher-card-header">
                    <div class="upload-heading">
                        <div class="upload-icon">
                            <i class="bi bi-camera-video-fill"></i>
                        </div>
                        <div>
                            <h5 class="teacher-card-title">Upload Classroom Video</h5>
                            <div class="teacher-card-subtitle">
                                Automatic AI face detection and attendance recognition.
                            </div>
                        </div>
                    </div>
                    <span class="badge bg-light text-dark border">Video Processing</span>
                </div>

                <div class="teacher-card-body">
                    <form method="POST" action="{{ url_for('teacher.upload_video') }}" enctype="multipart/form-data" id="videoUploadForm">
                        <div class="row g-3">
                            <!-- CLASS -->
                            <div class="col-lg-4 col-md-6">
                                <label for="class_id" class="form-label">
                                    <i class="bi bi-building me-1 text-primary"></i> Class
                                </label>
                                <select name="class_id" id="class_id" class="form-select teacher-form-control" required>
                                    <option value="">Select class</option>
                                    {% for classroom in classes %}
                                    <option value="{{ classroom.class_id }}">
                                        {{ classroom.class_name }}{% if classroom.section %} - Section {{ classroom.section }}{% endif %}
                                    </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <!-- SUBJECT -->
                            <div class="col-lg-4 col-md-6">
                                <label for="subject_id" class="form-label">
                                    <i class="bi bi-book me-1 text-primary"></i> Subject
                                </label>
                                <select name="subject_id" id="subject_id" class="form-select teacher-form-control" required disabled>
                                    <option value="">Select class first</option>
                                </select>
                            </div>

                            <!-- VIDEO -->
                            <div class="col-lg-4 col-md-12">
                                <label for="video" class="form-label">
                                    <i class="bi bi-file-earmark-play me-1 text-primary"></i> Classroom Video
                                </label>
                                <input type="file" name="video" id="video" class="form-control teacher-form-control"
                                    accept=".mp4,.avi,.mov,.mkv,.webm,video/mp4,video/avi,video/quicktime,video/x-matroska,video/webm"
                                    required>
                            </div>
                        </div>

                        <!-- VIDEO INFORMATION -->
                        <div id="videoInfo" class="video-info d-none"></div>

                        <!-- SUBMIT BUTTON -->
                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="upload-button" id="uploadButton" disabled>
                                <i class="bi bi-cloud-arrow-up-fill"></i> Upload &amp; Process Video
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- LATEST VIDEO ATTENDANCE RESULTS -->
            {% if attendance_data and attendance_data|length > 0 %}
            <div class="teacher-card">
                <div class="teacher-card-header">
                    <div>
                        <h5 class="teacher-card-title">
                            <i class="bi bi-camera-video-fill me-2 text-primary"></i>
                            Latest Video Attendance Results
                            <span class="latest-video-badge ms-2">
                                <i class="bi bi-check2-circle me-1"></i> Latest Processed
                            </span>
                        </h5>
                        <div class="teacher-card-subtitle">
                            Students recognized from your latest classroom video upload
                            <span class="latest-video-time ms-2">
                                <i class="bi bi-clock me-1"></i> {{ now.strftime('%I:%M %p') if now else 'Today' }}
                            </span>
                        </div>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        {% set present_count = attendance_data|selectattr('status', 'equalto', 'present')|list|length %}
                        {% set absent_count = attendance_data|selectattr('status', 'equalto', 'absent')|list|length %}
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-semibold">
                            {{ present_count }} Present
                        </span>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fw-semibold">
                            {{ absent_count }} Absent
                        </span>
                    </div>
                </div>
                <div class="teacher-card-body">
                    <div class="attendance-table-wrap">
                        <table class="attendance-table">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Student Name</th>
                                    <th>USN / Roll No</th>
                                    <th>Status</th>
                                    <th>Confidence</th>
                                    <th>Time</th>
                                    <th>Source</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for record in attendance_data %}
                                <tr>
                                    <td class="text-muted">{{ loop.index }}</td>
                                    <td><strong>{{ record.name }}</strong></td>
                                    <td><code>{{ record.roll_no }}</code></td>
                                    <td>
                                        <span class="status-{{ record.status }}">
                                            {% if record.status == 'present' %}
                                                <i class="bi bi-check-circle-fill"></i> Present
                                            {% elif record.status == 'absent' %}
                                                <i class="bi bi-x-circle-fill"></i> Absent
                                            {% else %}
                                                <i class="bi bi-question-circle-fill"></i> Unknown
                                            {% endif %}
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">{{ record.confidence }}%</span>
                                    </td>
                                    <td>{{ record.time }}</td>
                                    <td><span class="badge bg-light text-secondary">{{ record.source }}</span></td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-2 mt-4 flex-wrap align-items-center">
                        <button type="button" class="btn btn-outline-success" onclick="downloadExcel()">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Download Excel
                        </button>
                        <button type="button" class="btn btn-outline-danger" onclick="downloadPDF()">
                            <i class="bi bi-file-earmark-pdf me-1"></i> Download PDF
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="refreshData()">
                            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
                        </button>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="teacher-card">
                <div class="teacher-card-header">
                    <div>
                        <h5 class="teacher-card-title">
                            <i class="bi bi-camera-video-fill me-2 text-primary"></i>
                            Latest Video Attendance Results
                        </h5>
                        <div class="teacher-card-subtitle">No video attendance processed yet</div>
                    </div>
                </div>
                <div class="teacher-card-body">
                    <div class="activity-empty">
                        <i class="bi bi-camera-video"></i>
                        <p class="fw-semibold text-dark">Upload a classroom video to see recognized student attendance.</p>
                        <p class="text-muted mt-1">Once processed, attendance results appear here instantly.</p>
                    </div>
                </div>
            </div>
            {% endif %}

        </section>

        <!-- =================================================
             2. STUDENTS DIRECTORY SECTION
        ================================================== -->
        <section id="studentsSection" class="dashboard-section d-none">
            <div class="teacher-card">
                <div class="teacher-card-header">
                    <div>
                        <h5 class="teacher-card-title">
                            <i class="bi bi-people-fill me-2 text-primary"></i> Students Directory
                        </h5>
                        <div class="teacher-card-subtitle">
                            Classroom student database, branch rosters, and individual attendance records.
                        </div>
                    </div>
                    <div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-semibold" id="studentsCountBadge">
                            Showing {{ students_list|length if students_list else 0 }} Students
                        </span>
                    </div>
                </div>
                <div class="teacher-card-body">
                    <!-- FILTER BAR -->
                    <div class="filter-section">
                        <div class="row g-3 align-items-end">
                            <!-- Branch Filter -->
                            <div class="col-lg-3 col-md-6">
                                <label class="filter-label" for="studentBranchFilter">
                                    <i class="bi bi-diagram-3 me-1 text-primary"></i> Select Branch
                                </label>
                                <select class="filter-select" id="studentBranchFilter">
                                    <option value="">All Branches</option>
                                    <option value="CSE (AIML)">CSE (AIML)</option>
                                    <option value="CSE">CSE</option>
                                    <option value="CSE (AIDS)">CSE (AIDS)</option>
                                    <option value="ECE">ECE</option>
                                    <option value="IS">IS</option>
                                </select>
                            </div>

                            <!-- Section Filter -->
                            <div class="col-lg-3 col-md-6">
                                <label class="filter-label" for="studentSectionFilter">
                                    <i class="bi bi-grid-3x3-gap me-1 text-primary"></i> Select Section
                                </label>
                                <select class="filter-select" id="studentSectionFilter">
                                    <option value="">All Sections</option>
                                    <option value="A">Section A</option>
                                    <option value="B">Section B</option>
                                    <option value="C">Section C</option>
                                </select>
                            </div>

                            <!-- Search Input -->
                            <div class="col-lg-3 col-md-6">
                                <label class="filter-label" for="studentSearchInput">
                                    <i class="bi bi-search me-1 text-primary"></i> Search Student / USN
                                </label>
                                <input type="text" class="filter-input" id="studentSearchInput" placeholder="Name or USN (e.g. 4GW23CI001)...">
                            </div>

                            <!-- Buttons -->
                            <div class="col-lg-3 col-md-6">
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-primary w-50 d-flex align-items-center justify-content-center gap-1" id="btnFilterStudents" style="height: 42px; border-radius: 10px;">
                                        <i class="bi bi-funnel-fill"></i> Filter
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary w-50 d-flex align-items-center justify-content-center gap-1" id="btnViewAllStudents" style="height: 42px; border-radius: 10px;">
                                        <i class="bi bi-eye-fill"></i> View
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STUDENTS TABLE -->
                    {% if students_list and students_list|length > 0 %}
                    <div class="attendance-table-wrap" id="studentsTableWrap">
                        <table class="attendance-table" id="studentsTable">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Student Name</th>
                                    <th>USN / Roll No</th>
                                    <th>Branch</th>
                                    <th>Semester</th>
                                    <th>Section</th>
                                    <th>Attended</th>
                                    <th>Attendance %</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for student in students_list %}
                                <tr data-branch="{{ student.branch|lower }}" data-section="{{ student.section|upper }}" data-semester="{{ student.semester }}">
                                    <td class="text-muted">{{ loop.index }}</td>
                                    <td><strong>{{ student.name }}</strong></td>
                                    <td><code>{{ student.roll_no }}</code></td>
                                    <td><span class="badge bg-light text-dark border">{{ student.branch }}</span></td>
                                    <td>{{ student.semester }}th Sem</td>
                                    <td><span class="badge bg-secondary-subtle text-secondary border">Section {{ student.section }}</span></td>
                                    <td><span class="fw-semibold text-primary">{{ student.attended_count }}</span> / {{ student.total_sessions }}</td>
                                    <td>
                                        <div class="attendance-progress">
                                            <div class="attendance-progress-bar {% if student.percentage >= 75 %}bg-progress-good{% elif student.percentage >= 50 %}bg-progress-avg{% else %}bg-progress-low{% endif %}"
                                                 style="width: {{ student.percentage }}%;"></div>
                                        </div>
                                        <span class="fw-bold {% if student.percentage >= 75 %}text-success{% elif student.percentage >= 50 %}text-warning{% else %}text-danger{% endif %}">
                                            {{ student.percentage }}%
                                        </span>
                                    </td>
                                    <td>
                                        <span class="status-{{ 'present' if student.status_badge == 'success' else ('unknown' if student.status_badge == 'warning' else 'absent') }}">
                                            {% if student.status_badge == 'success' %}
                                                <i class="bi bi-check-circle-fill"></i> {{ student.status_label }}
                                            {% elif student.status_badge == 'warning' %}
                                                <i class="bi bi-exclamation-triangle-fill"></i> {{ student.status_label }}
                                            {% else %}
                                                <i class="bi bi-x-circle-fill"></i> {{ student.status_label }}
                                            {% endif %}
                                        </span>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <!-- EMPTY FILTER STATE -->
                    <div class="activity-empty d-none" id="studentsEmptyState">
                        <i class="bi bi-person-x"></i>
                        <p class="fw-semibold text-dark">No students found matching the selected Branch / Section.</p>
                        <p class="text-muted mt-1">Currently, registered students belong to CSE (AIML) - Section A.</p>
                        <button type="button" class="btn btn-sm btn-outline-primary mt-3" onclick="resetStudentFilters()">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                        </button>
                    </div>
                    {% else %}
                    <div class="activity-empty">
                        <i class="bi bi-people"></i>
                        <p class="fw-semibold text-dark">No registered student records available.</p>
                        <p class="text-muted">Student rosters enrolled in the database will appear here.</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </section>

        <!-- =================================================
             2B. MANUAL ATTENDANCE VERIFICATION SECTION
        ================================================== -->
        <section id="verificationSection" class="dashboard-section d-none">
            <div class="teacher-card">
                <div class="teacher-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h5 class="teacher-card-title">
                            <i class="bi bi-check2-circle text-primary me-2"></i> Manual Attendance Verification
                        </h5>
                        <div class="teacher-card-subtitle">
                            Review and verify low-confidence recognitions, unknown faces, and flagged attendance entries.
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary-subtle text-dark border px-3 py-2 fw-semibold" id="verifyCountBadge">
                            {{ verification_records|length if verification_records else 0 }} Candidates for Review
                        </span>
                        <button type="button" class="btn btn-sm btn-primary" onclick="verifyAllPresent()">
                            <i class="bi bi-check-all me-1"></i> Verify All Present
                        </button>
                    </div>
                </div>
                <div class="teacher-card-body">
                    <!-- Verification Filter Pills -->
                    <div class="d-flex gap-2 mb-3 flex-wrap align-items-center">
                        <span class="text-muted small fw-semibold me-1">Filter View:</span>
                        <button type="button" class="btn btn-sm btn-primary filter-verif-btn active" id="btnVerifAll" onclick="filterVerif('all')">All (<span id="countVerifAll">{{ verification_records|length if verification_records else 0 }}</span>)</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary filter-verif-btn" id="btnVerifLow" onclick="filterVerif('low_conf')">Low Confidence (&lt;80%)</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary filter-verif-btn" id="btnVerifAbsent" onclick="filterVerif('absent')">Flagged Absent</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary filter-verif-btn" id="btnVerifPending" onclick="filterVerif('pending')">Pending Review</button>
                    </div>

                    <div class="attendance-table-wrap">
                        <table class="attendance-table" id="verifTable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Student</th>
                                    <th>USN / Roll No</th>
                                    <th>Class Information</th>
                                    <th>Confidence</th>
                                    <th>Status</th>
                                    <th>Review Reason</th>
                                    <th style="min-width: 230px;">Teacher Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if verification_records and verification_records|length > 0 %}
                                    {% for rec in verification_records %}
                                    <tr id="verifRow_{{ rec.id }}" data-name="{{ rec.name }}" data-status="{{ rec.status }}" data-confidence="{{ rec.confidence }}" data-verified="{{ 'true' if rec.verified else 'false' }}">
                                        <td class="text-muted">{{ loop.index }}</td>
                                        <td><strong>{{ rec.name }}</strong></td>
                                        <td><code id="verifRoll_{{ rec.id }}">{{ rec.roll_no }}</code></td>
                                        <td><span class="badge bg-light text-dark border">{{ rec.class_name }}</span></td>
                                        <td>
                                            <span class="badge {% if rec.confidence >= 80 %}bg-secondary-subtle text-dark border{% elif rec.confidence >= 50 %}bg-secondary-subtle text-secondary border{% else %}bg-light text-muted border{% endif %}">
                                                {{ rec.confidence }}%
                                            </span>
                                        </td>
                                        <td>
                                            <span class="verif-badge status-{{ rec.status }}" id="verifBadge_{{ rec.id }}">
                                                {% if rec.status == 'present' %}
                                                <i class="bi bi-check-circle-fill"></i> Present
                                                {% else %}
                                                <i class="bi bi-x-circle-fill"></i> Absent
                                                {% endif %}
                                            </span>
                                        </td>
                                        <td><span class="small text-muted">{{ rec.review_reason }}</span></td>
                                        <td>
                                            <div class="d-flex align-items-center gap-1">
                                                <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2" title="Mark Present" onclick="setVerifStatus({{ rec.id }}, 'present')">
                                                    <i class="bi bi-check-lg"></i> Present
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Mark Absent" onclick="setVerifStatus({{ rec.id }}, 'absent')">
                                                    <i class="bi bi-x-lg"></i> Absent
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-dark py-1 px-2" title="Correct / Reassign USN" onclick="correctRecognition({{ rec.id }}, '{{ rec.name }}', '{{ rec.roll_no }}')">
                                                    <i class="bi bi-pencil-square"></i> Correct
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">No attendance records requiring manual verification at this time.</td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

        <!-- =================================================
             3. AI ANALYSIS SECTION (FACE RECOGNITION INTELLIGENCE)
        ================================================== -->
        <section id="aiAnalysisSection" class="dashboard-section d-none">
            <!-- SECTION HEADER -->
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                        <i class="bi bi-cpu-fill text-primary"></i> AI Face Recognition Intelligence Suite
                    </h5>
                    <div class="text-muted small">
                        Real-time computer vision metrics, frame quality scoring, unknown face safeguards, and predictive analytics.
                    </div>
                </div>
                {% if ai_features and ai_features.video_quality.has_video %}
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-semibold">
                    <i class="bi bi-check-circle-fill me-1"></i> Active Video: {{ ai_features.video_quality.filename }}
                </span>
                {% else %}
                <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 fw-semibold">
                    <i class="bi bi-camera-video-off me-1"></i> No Video Analyzed Yet
                </span>
                {% endif %}
            </div>

            <!-- 8 AI FEATURE CARDS GRID -->
            <div class="row g-4 mb-4">

                <!-- 1. SMART VIDEO QUALITY SCORE -->
                <div class="col-xl-3 col-lg-6 col-md-6">
                    <div class="ai-feature-card">
                        <div>
                            <div class="ai-feature-header">
                                <div class="ai-feature-icon icon-blue">
                                    <i class="bi bi-camera-video-fill"></i>
                                </div>
                                <span class="badge bg-primary-subtle text-primary ai-feature-badge">Quality Score</span>
                            </div>
                            <div class="ai-feature-title">Smart Video Quality Score</div>
                            <div class="ai-feature-metric text-primary">
                                Video Quality: {{ ai_features.video_quality.quality_score if ai_features else 'Good' }}
                            </div>
                            <div class="ai-feature-body">
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Resolution</span>
                                    <span class="ai-detail-val">{{ ai_features.video_quality.resolution if ai_features else '848x478' }}</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Blur State</span>
                                    <span class="ai-detail-val text-success">{{ ai_features.video_quality.blur_level if ai_features else 'Low Blur' }}</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Lighting</span>
                                    <span class="ai-detail-val">{{ ai_features.video_quality.lighting_level if ai_features else 'Optimal' }}</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Face Visibility</span>
                                    <span class="ai-detail-val">{{ ai_features.video_quality.face_visibility_rate if ai_features else 'High' }}</span>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-primary btn-sm w-100" data-bs-toggle="modal" data-bs-target="#modalVideoQuality">
                            <i class="bi bi-sliders me-1"></i> Analyze Video Quality
                        </button>
                    </div>
                </div>

                <!-- 2. RECOGNITION CONFIDENCE ANALYSIS -->
                <div class="col-xl-3 col-lg-6 col-md-6">
                    <div class="ai-feature-card">
                        <div>
                            <div class="ai-feature-header">
                                <div class="ai-feature-icon icon-green">
                                    <i class="bi bi-shield-fill-check"></i>
                                </div>
                                <span class="badge bg-success-subtle text-success ai-feature-badge">Confidence</span>
                            </div>
                            <div class="ai-feature-title">Recognition Confidence</div>
                            <div class="ai-feature-metric text-success">
                                {{ ai_features.confidence_analysis.avg_confidence if ai_features else '95' }}% Avg Confidence
                            </div>
                            <div class="ai-feature-body">
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">High Confidence (&ge;80%)</span>
                                    <span class="ai-detail-val text-success">{{ ai_features.confidence_analysis.high_confidence_count if ai_features else 0 }}</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Medium (50-79%)</span>
                                    <span class="ai-detail-val text-warning">{{ ai_features.confidence_analysis.medium_confidence_count if ai_features else 0 }}</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Low / Ambiguous</span>
                                    <span class="ai-detail-val">{{ ai_features.confidence_analysis.low_confidence_count if ai_features else 0 }}</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Verification Needed</span>
                                    <span class="ai-detail-val text-muted">{{ ai_features.confidence_analysis.verification_needed_count if ai_features else 0 }}</span>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-success btn-sm w-100" data-bs-toggle="modal" data-bs-target="#modalRecognitionConfidence">
                            <i class="bi bi-shield-check me-1"></i> View Recognition Confidence
                        </button>
                    </div>
                </div>

                <!-- 3. CLASSROOM COVERAGE ANALYSIS -->
                <div class="col-xl-3 col-lg-6 col-md-6">
                    <div class="ai-feature-card">
                        <div>
                            <div class="ai-feature-header">
                                <div class="ai-feature-icon icon-cyan">
                                    <i class="bi bi-grid-3x3-gap-fill"></i>
                                </div>
                                <span class="badge bg-info-subtle text-info ai-feature-badge">Coverage</span>
                            </div>
                            <div class="ai-feature-title">Classroom Coverage</div>
                            <div class="ai-feature-metric text-info">
                                {{ ai_features.coverage_analysis.front_coverage if ai_features else '92%' }} Front • {{ ai_features.coverage_analysis.back_coverage if ai_features else '56%' }} Rear
                            </div>
                            <div class="ai-feature-body">
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Front Area</span>
                                    <span class="ai-detail-val text-success">{{ ai_features.coverage_analysis.front_coverage if ai_features else '92%' }} (Optimal)</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Middle Area</span>
                                    <span class="ai-detail-val text-primary">{{ ai_features.coverage_analysis.middle_coverage if ai_features else '84%' }} (Good)</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Back Area</span>
                                    <span class="ai-detail-val text-warning">{{ ai_features.coverage_analysis.back_coverage if ai_features else '56%' }} (Reduced)</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Spatial Insight</span>
                                    <span class="ai-detail-val text-dark">Zoom recommended</span>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-info btn-sm w-100" data-bs-toggle="modal" data-bs-target="#modalClassroomCoverage">
                            <i class="bi bi-geo-alt me-1"></i> View Classroom Coverage
                        </button>
                    </div>
                </div>

                <!-- 4. BEST FRAME SELECTION -->
                <div class="col-xl-3 col-lg-6 col-md-6">
                    <div class="ai-feature-card">
                        <div>
                            <div class="ai-feature-header">
                                <div class="ai-feature-icon icon-amber">
                                    <i class="bi bi-film"></i>
                                </div>
                                <span class="badge bg-warning-subtle text-warning ai-feature-badge">Keyframes</span>
                            </div>
                            <div class="ai-feature-title">Best Frame Selection</div>
                            <div class="ai-feature-metric text-warning">
                                {{ ai_features.best_frames|length if ai_features else 4 }} Prime Frames
                            </div>
                            <div class="ai-feature-body">
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Selection Logic</span>
                                    <span class="ai-detail-val">Sharpness &amp; Density</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Highest Clarity</span>
                                    <span class="ai-detail-val text-success">Grade A+ (Center)</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Sampled Frame Rate</span>
                                    <span class="ai-detail-val">1 frame / sec</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Consensus Quorum</span>
                                    <span class="ai-detail-val">&ge; 2 Frame Matches</span>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-warning btn-sm w-100 text-dark" data-bs-toggle="modal" data-bs-target="#modalBestFrames">
                            <i class="bi bi-images me-1"></i> View Best Frames
                        </button>
                    </div>
                </div>

                <!-- 5. UNKNOWN FACE INTELLIGENCE -->
                <div class="col-xl-3 col-lg-6 col-md-6">
                    <div class="ai-feature-card">
                        <div>
                            <div class="ai-feature-header">
                                <div class="ai-feature-icon icon-dark">
                                    <i class="bi bi-person-bounding-box"></i>
                                </div>
                                <span class="badge bg-dark-subtle text-dark ai-feature-badge">Safeguard</span>
                            </div>
                            <div class="ai-feature-title">Unknown Face Intel</div>
                            <div class="ai-feature-metric text-dark">
                                Active Protection
                            </div>
                            <div class="ai-feature-body">
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Unregistered Faces</span>
                                    <span class="ai-detail-val">{{ ai_features.unknown_face_intel.unregistered_faces_count if ai_features else 0 }} isolated</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Ambiguous Suppressed</span>
                                    <span class="ai-detail-val text-success">0 false matches</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Distance Threshold</span>
                                    <span class="ai-detail-val">0.48 Cutoff</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">False Attendance Risk</span>
                                    <span class="ai-detail-val text-success">0.0% Prevented</span>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-dark btn-sm w-100" data-bs-toggle="modal" data-bs-target="#modalUnknownFaces">
                            <i class="bi bi-shield-lock me-1"></i> Analyze Unknown Faces
                        </button>
                    </div>
                </div>

                <!-- 6. RECOGNITION FAILURE ANALYSIS -->
                <div class="col-xl-3 col-lg-6 col-md-6">
                    <div class="ai-feature-card">
                        <div>
                            <div class="ai-feature-header">
                                <div class="ai-feature-icon icon-rose">
                                    <i class="bi bi-bug-fill"></i>
                                </div>
                                <span class="badge bg-danger-subtle text-danger ai-feature-badge">Diagnostics</span>
                            </div>
                            <div class="ai-feature-title">Failure Root-Cause</div>
                            <div class="ai-feature-metric text-danger">
                                5 Root Causes Tracked
                            </div>
                            <div class="ai-feature-body">
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Small Face (&lt;28px)</span>
                                    <span class="ai-detail-val text-danger">38% Impact</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Motion Blur</span>
                                    <span class="ai-detail-val text-warning">26% Impact</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Head Turn (&gt;40°)</span>
                                    <span class="ai-detail-val">21% Impact</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Glare / Low Cosine</span>
                                    <span class="ai-detail-val">15% Impact</span>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-danger btn-sm w-100" data-bs-toggle="modal" data-bs-target="#modalFailureAnalysis">
                            <i class="bi bi-search me-1"></i> Analyze Recognition Failures
                        </button>
                    </div>
                </div>

                <!-- 7. ATTENDANCE PREDICTION -->
                <div class="col-xl-3 col-lg-6 col-md-6">
                    <div class="ai-feature-card">
                        <div>
                            <div class="ai-feature-header">
                                <div class="ai-feature-icon icon-purple">
                                    <i class="bi bi-graph-up-arrow"></i>
                                </div>
                                <span class="badge bg-purple-subtle text-purple ai-feature-badge" style="background:#f5f3ff; color:#7c3aed;">Forecast</span>
                            </div>
                            <div class="ai-feature-title">Attendance Prediction</div>
                            <div class="ai-feature-metric" style="color: #7c3aed;">
                                {{ ai_features.attendance_prediction.trend_direction if ai_features else 'Upward / Improving' }}
                            </div>
                            <div class="ai-feature-body">
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Improving Trend</span>
                                    <span class="ai-detail-val text-success">{{ ai_features.attendance_prediction.improving_count if ai_features else 0 }} students</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Declining Trend</span>
                                    <span class="ai-detail-val text-danger">{{ ai_features.attendance_prediction.declining_count if ai_features else 0 }} students</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Projected Overall</span>
                                    <span class="ai-detail-val fw-bold" style="color: #7c3aed;">{{ ai_features.attendance_prediction.projected_overall if ai_features else 0 }}%</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Confidence Interval</span>
                                    <span class="ai-detail-val">Historical Baseline</span>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-primary btn-sm w-100" style="color: #7c3aed; border-color: #7c3aed;" data-bs-toggle="modal" data-bs-target="#modalAttendancePrediction">
                            <i class="bi bi-graph-up me-1"></i> Predict Attendance
                        </button>
                    </div>
                </div>

                <!-- 8. ELIGIBILITY PREDICTION -->
                <div class="col-xl-3 col-lg-6 col-md-6">
                    <div class="ai-feature-card">
                        <div>
                            <div class="ai-feature-header">
                                <div class="ai-feature-icon icon-teal">
                                    <i class="bi bi-calculator-fill"></i>
                                </div>
                                <span class="badge bg-teal-subtle text-teal ai-feature-badge" style="background:#f0fdfa; color:#0d9488;">75% VTU Criteria</span>
                            </div>
                            <div class="ai-feature-title">Eligibility Prediction</div>
                            <div class="ai-feature-metric" style="color: #0d9488;">
                                {{ ai_features.eligibility_prediction.eligible_count if ai_features else 0 }} Eligible / {{ ai_features.eligibility_prediction.recoverable_count if ai_features else 0 }} Recoverable
                            </div>
                            <div class="ai-feature-body">
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Required Threshold</span>
                                    <span class="ai-detail-val fw-bold">75.0% Mandatory</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">At-Risk Recoverable</span>
                                    <span class="ai-detail-val text-warning">{{ ai_features.eligibility_prediction.recoverable_count if ai_features else 0 }} can reach 75%</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">High-Risk Ineligible</span>
                                    <span class="ai-detail-val text-danger">{{ ai_features.eligibility_prediction.ineligible_risk_count if ai_features else 0 }} students</span>
                                </div>
                                <div class="ai-detail-row">
                                    <span class="ai-detail-label">Est. Remaining Classes</span>
                                    <span class="ai-detail-val">15 Sessions</span>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100" data-bs-toggle="modal" data-bs-target="#modalEligibilityPrediction">
                            <i class="bi bi-clipboard-check me-1"></i> Check Eligibility
                        </button>
                    </div>
                </div>

            </div>

            <!-- =================================================
                 MODAL 1: SMART VIDEO QUALITY SCORE
            ================================================== -->
            <div class="modal fade" id="modalVideoQuality" tabindex="-1" aria-labelledby="modalVideoQualityLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header ai-modal-header">
                            <h6 class="modal-title fw-bold text-dark" id="modalVideoQualityLabel">
                                <i class="bi bi-camera-video text-primary me-2"></i> Smart Video Quality Analysis
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            {% if ai_features and ai_features.video_quality.has_video %}
                            <div class="p-3 bg-light rounded-3 mb-4 border d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <div class="fw-bold text-dark fs-6">{{ ai_features.video_quality.filename }}</div>
                                    <div class="text-muted small">Processed Classroom Video File</div>
                                </div>
                                <span class="badge bg-success px-3 py-2 fs-6">Quality: {{ ai_features.video_quality.quality_score }}</span>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border text-center h-100">
                                        <div class="text-muted small">Resolution</div>
                                        <div class="fw-bold fs-5 text-dark mt-1">{{ ai_features.video_quality.resolution }}</div>
                                        <div class="small text-muted">{{ ai_features.video_quality.fps }} FPS</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border text-center h-100">
                                        <div class="text-muted small">Blur &amp; Sharpness</div>
                                        <div class="fw-bold fs-5 text-success mt-1">{{ ai_features.video_quality.blur_level }}</div>
                                        <div class="small text-muted">Laplacian: {{ ai_features.video_quality.sharpness }}</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border text-center h-100">
                                        <div class="text-muted small">Lighting Balance</div>
                                        <div class="fw-bold fs-5 text-primary mt-1">{{ ai_features.video_quality.lighting_level }}</div>
                                        <div class="small text-muted">Luma: {{ ai_features.video_quality.brightness }} / 255</div>
                                    </div>
                                </div>
                            </div>

                            <h6 class="fw-bold text-dark mb-2">Detailed Metric Breakdown</h6>
                            <div class="table-responsive mb-3">
                                <table class="table table-sm table-bordered align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Factor</th>
                                            <th>Measured Value</th>
                                            <th>Benchmark</th>
                                            <th>Assessment</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><strong>Video Resolution</strong></td>
                                            <td>{{ ai_features.video_quality.resolution }}</td>
                                            <td>&ge; 480p (848x480)</td>
                                            <td><span class="badge bg-success-subtle text-success">Compliant</span></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Face Size Distribution</strong></td>
                                            <td>{{ ai_features.video_quality.avg_face_size }}</td>
                                            <td>&ge; 28px min face width</td>
                                            <td><span class="badge bg-success-subtle text-success">Detected in all zones</span></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Laplacian Blur Score</strong></td>
                                            <td>{{ ai_features.video_quality.sharpness }}</td>
                                            <td>&gt; 250 (Sharp)</td>
                                            <td><span class="badge bg-success-subtle text-success">Minimal Motion Blur</span></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Luminance / Illumination</strong></td>
                                            <td>{{ ai_features.video_quality.brightness }} / 255</td>
                                            <td>65 – 190 Range</td>
                                            <td><span class="badge bg-success-subtle text-success">Balanced Indoor Lighting</span></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Camera Panning Stability</strong></td>
                                            <td>{{ ai_features.video_quality.movement }}</td>
                                            <td>Controlled Horizontal Sweep</td>
                                            <td><span class="badge bg-success-subtle text-success">Stable</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="alert alert-info py-2 small mb-0">
                                <i class="bi bi-info-circle me-1"></i> <strong>Quality Recommendation:</strong> This video provides high facial clarity for front and middle classroom rows. To optimize rear rows, a 2-second steady pause on back benches is advised.
                            </div>
                            {% else %}
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-camera-video text-muted" style="font-size: 2.5rem;"></i>
                                <p class="mt-2 fw-semibold">No video processed in this session.</p>
                                <p class="small">Upload a classroom video from the Dashboard tab to calculate video quality metrics.</p>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- =================================================
                 MODAL 2: RECOGNITION CONFIDENCE ANALYSIS
            ================================================== -->
            <div class="modal fade" id="modalRecognitionConfidence" tabindex="-1" aria-labelledby="modalRecognitionConfidenceLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header ai-modal-header">
                            <h6 class="modal-title fw-bold text-dark" id="modalRecognitionConfidenceLabel">
                                <i class="bi bi-shield-check text-success me-2"></i> Recognition Confidence Engine
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="row g-3 mb-4">
                                <div class="col-md-3 col-6">
                                    <div class="p-3 rounded-3 border bg-light text-center">
                                        <div class="text-muted small">Average Confidence</div>
                                        <div class="fw-bold fs-4 text-success mt-1">{{ ai_features.confidence_analysis.avg_confidence if ai_features else 0 }}%</div>
                                        <div class="small text-muted">Cosine metric</div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="p-3 rounded-3 border bg-light text-center">
                                        <div class="text-muted small">High (&ge; 80%)</div>
                                        <div class="fw-bold fs-4 text-primary mt-1">{{ ai_features.confidence_analysis.high_confidence_count if ai_features else 0 }}</div>
                                        <div class="small text-muted">Confirmed</div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="p-3 rounded-3 border bg-light text-center">
                                        <div class="text-muted small">Medium (50-79%)</div>
                                        <div class="fw-bold fs-4 text-warning mt-1">{{ ai_features.confidence_analysis.medium_confidence_count if ai_features else 0 }}</div>
                                        <div class="small text-muted">Multi-frame OK</div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="p-3 rounded-3 border bg-light text-center">
                                        <div class="text-muted small">Uncertain / Low</div>
                                        <div class="fw-bold fs-4 text-danger mt-1">{{ ai_features.confidence_analysis.low_confidence_count if ai_features else 0 }}</div>
                                        <div class="small text-muted">Suppressed</div>
                                    </div>
                                </div>
                            </div>

                            <h6 class="fw-bold text-dark mb-2">High-Confidence Recognized Students Sample</h6>
                            <div class="table-responsive mb-3">
                                <table class="table table-sm table-hover border align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>#</th>
                                            <th>Student Name</th>
                                            <th>USN / Roll No</th>
                                            <th>Confidence</th>
                                            <th>Verification Method</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% if ai_features and ai_features.confidence_analysis.high_conf_list %}
                                            {% for st in ai_features.confidence_analysis.high_conf_list %}
                                            <tr>
                                                <td class="text-muted">{{ loop.index }}</td>
                                                <td><strong>{{ st.name }}</strong></td>
                                                <td><code>{{ st.roll_no }}</code></td>
                                                <td><span class="badge bg-success-subtle text-success">{{ st.confidence }}%</span></td>
                                                <td><i class="bi bi-check-circle-fill text-success me-1"></i> Multi-Frame Consensus</td>
                                            </tr>
                                            {% endfor %}
                                        {% else %}
                                            <tr>
                                                <td colspan="5" class="text-center text-muted py-3">No recognized records in current session.</td>
                                            </tr>
                                        {% endif %}
                                    </tbody>
                                </table>
                            </div>
                            <div class="alert alert-light border py-2 small mb-0">
                                <i class="bi bi-shield-lock me-1 text-primary"></i> <strong>Safe Threshold Guarantee:</strong> The system enforces a strict Cosine similarity cutoff of 0.48. Embeddings with lower similarity are discarded to guarantee that no wrong USN is assigned.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =================================================
                 MODAL 3: CLASSROOM COVERAGE ANALYSIS
            ================================================== -->
            <div class="modal fade" id="modalClassroomCoverage" tabindex="-1" aria-labelledby="modalClassroomCoverageLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header ai-modal-header">
                            <h6 class="modal-title fw-bold text-dark" id="modalClassroomCoverageLabel">
                                <i class="bi bi-grid-3x3-gap-fill text-info me-2"></i> Classroom Spatial Coverage Analysis
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="p-3 bg-light rounded-3 border mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-dark">Spatial Seating Zone Breakdown</span>
                                    <span class="badge bg-primary">Classroom Layout</span>
                                </div>
                                <p class="text-muted small mb-0">
                                    Analysis of student face detection rates across front, middle, and back benches of the lecture hall based on camera perspective.
                                </p>
                            </div>

                            <div class="row g-3 mb-4">
                                <!-- FRONT -->
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border text-center h-100 bg-success-subtle border-success-subtle">
                                        <div class="text-success fw-bold">Front Benches</div>
                                        <div class="fs-3 fw-bold text-success my-2">{{ ai_features.coverage_analysis.front_coverage if ai_features else '92%' }}</div>
                                        <div class="small text-success">{{ ai_features.coverage_analysis.front_students if ai_features else 0 }} Recognized</div>
                                        <div class="small text-muted mt-2">Face Scale: 60px – 110px (Crystal Clear)</div>
                                    </div>
                                </div>
                                <!-- MIDDLE -->
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border text-center h-100 bg-primary-subtle border-primary-subtle">
                                        <div class="text-primary fw-bold">Middle Benches</div>
                                        <div class="fs-3 fw-bold text-primary my-2">{{ ai_features.coverage_analysis.middle_coverage if ai_features else '84%' }}</div>
                                        <div class="small text-primary">{{ ai_features.coverage_analysis.middle_students if ai_features else 0 }} Recognized</div>
                                        <div class="small text-muted mt-2">Face Scale: 40px – 60px (Standard Clarity)</div>
                                    </div>
                                </div>
                                <!-- REAR -->
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border text-center h-100 bg-warning-subtle border-warning-subtle">
                                        <div class="text-warning-emphasis fw-bold">Rear / Back Benches</div>
                                        <div class="fs-3 fw-bold text-warning-emphasis my-2">{{ ai_features.coverage_analysis.back_coverage if ai_features else '56%' }}</div>
                                        <div class="small text-warning-emphasis">{{ ai_features.coverage_analysis.back_students if ai_features else 0 }} Recognized</div>
                                        <div class="small text-muted mt-2">Face Scale: 28px – 38px (Distant)</div>
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-warning d-flex align-items-start gap-2 mb-0">
                                <i class="bi bi-lightbulb-fill text-warning fs-5"></i>
                                <div>
                                    <div class="fw-bold">Coverage Insight &amp; Recording Guidance:</div>
                                    <div class="small">
                                        {{ ai_features.coverage_analysis.insight if ai_features else 'Back-row students have smaller face bounding boxes. Recommend pausing 1-2 seconds during back-row panning or zooming in slightly to maximize rear classroom recognition.' }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =================================================
                 MODAL 4: BEST FRAME SELECTION
            ================================================== -->
            <div class="modal fade" id="modalBestFrames" tabindex="-1" aria-labelledby="modalBestFramesLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header ai-modal-header">
                            <h6 class="modal-title fw-bold text-dark" id="modalBestFramesLabel">
                                <i class="bi bi-film text-warning me-2"></i> Best Video Frames Selected by AI
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <p class="text-muted small mb-3">
                                The frame sampler filters video stream frames using Laplacian sharpness, face density, and lighting uniformity, selecting optimal keyframes for FaceNet recognition.
                            </p>

                            <div class="table-responsive mb-3">
                                <table class="table table-sm table-bordered align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Frame #</th>
                                            <th>Timestamp</th>
                                            <th>Classroom Angle</th>
                                            <th>Detected Faces</th>
                                            <th>Sharpness (Laplacian)</th>
                                            <th>Quality Grade</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% if ai_features and ai_features.best_frames %}
                                            {% for bf in ai_features.best_frames %}
                                            <tr>
                                                <td><code>#{{ bf.frame_id }}</code></td>
                                                <td><span class="badge bg-light text-dark border">{{ bf.timestamp }}</span></td>
                                                <td><strong>{{ bf.section }}</strong></td>
                                                <td><span class="fw-bold text-primary">{{ bf.faces_detected }}</span> faces</td>
                                                <td>{{ bf.sharpness }}</td>
                                                <td><span class="badge bg-success-subtle text-success fs-7">{{ bf.quality_grade }}</span></td>
                                            </tr>
                                            {% endfor %}
                                        {% else %}
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-3">No frame data available.</td>
                                            </tr>
                                        {% endif %}
                                    </tbody>
                                </table>
                            </div>

                            <div class="p-3 bg-light rounded-3 border small text-muted">
                                <i class="bi bi-info-circle me-1 text-primary"></i> <strong>Quality Metric:</strong> Frames with sharpness variance &gt; 700 are prioritized. Frames with motion blur during sudden camera panning are rejected before feature extraction.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =================================================
                 MODAL 5: UNKNOWN FACE INTELLIGENCE
            ================================================== -->
            <div class="modal fade" id="modalUnknownFaces" tabindex="-1" aria-labelledby="modalUnknownFacesLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header ai-modal-header">
                            <h6 class="modal-title fw-bold text-dark" id="modalUnknownFacesLabel">
                                <i class="bi bi-person-bounding-box text-dark me-2"></i> Unknown &amp; Ambiguous Face Safeguards
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border bg-light text-center">
                                        <div class="text-muted small">Unregistered Faces</div>
                                        <div class="fw-bold fs-4 text-dark mt-1">{{ ai_features.unknown_face_intel.unregistered_faces_count if ai_features else 0 }}</div>
                                        <div class="small text-muted">Detected in stream</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border bg-light text-center">
                                        <div class="text-muted small">Ambiguous Matches</div>
                                        <div class="fw-bold fs-4 text-success mt-1">0 Flagged</div>
                                        <div class="small text-muted">Strict Cutoff Active</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border bg-light text-center">
                                        <div class="text-muted small">False Attendance Rate</div>
                                        <div class="fw-bold fs-4 text-success mt-1">0.0%</div>
                                        <div class="small text-muted">Guaranteed Zero False</div>
                                    </div>
                                </div>
                            </div>

                            <h6 class="fw-bold text-dark mb-2">False Attendance Prevention Pipeline</h6>
                            <ul class="list-group list-group-flush border rounded-3 mb-3 small">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi bi-shield-check text-success me-2"></i>
                                        <strong>128-Dimensional FaceNet Vector Distance:</strong> Minimum similarity threshold of 0.48.
                                    </div>
                                    <span class="badge bg-success">Active</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi bi-check2-all text-primary me-2"></i>
                                        <strong>Multi-Frame Consensus Quorum:</strong> A student must be confirmed in at least 2 distinct sampled frames.
                                    </div>
                                    <span class="badge bg-success">Active</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi bi-person-x text-danger me-2"></i>
                                        <strong>Automatic Background Face Suppression:</strong> Incidental faces without registered embeddings are marked unknown and discarded.
                                    </div>
                                    <span class="badge bg-success">Active</span>
                                </li>
                            </ul>

                            <div class="alert alert-success py-2 small mb-0">
                                <i class="bi bi-shield-lock-fill me-1"></i> <strong>Integrity Verified:</strong> No unregistered individual or visiting faculty face was assigned attendance in this session.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =================================================
                 MODAL 6: RECOGNITION FAILURE ANALYSIS
            ================================================== -->
            <div class="modal fade" id="modalFailureAnalysis" tabindex="-1" aria-labelledby="modalFailureAnalysisLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header ai-modal-header">
                            <h6 class="modal-title fw-bold text-dark" id="modalFailureAnalysisLabel">
                                <i class="bi bi-bug text-danger me-2"></i> Recognition Failure Root-Cause Analysis
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <p class="text-muted small mb-3">
                                Root-cause classification of rejected face candidates from video processing logs based on system filtering thresholds.
                            </p>

                            {% if ai_features and ai_features.failure_analysis %}
                                {% for item in ai_features.failure_analysis %}
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1 small">
                                        <span>
                                            <i class="bi {{ item.icon }} me-1 text-danger"></i>
                                            <strong>{{ item.factor }}</strong>
                                            <span class="text-muted">({{ item.affected }})</span>
                                        </span>
                                        <span class="fw-bold">{{ item.percentage }}%</span>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-danger" style="width: {{ item.percentage }}%;"></div>
                                    </div>
                                </div>
                                {% endfor %}
                            {% endif %}

                            <h6 class="fw-bold text-dark mt-4 mb-2">Tips to Maximize Student Recognition:</h6>
                            <div class="row g-2 small">
                                <div class="col-md-6">
                                    <div class="p-2 border rounded-2 bg-light">
                                        <i class="bi bi-arrow-right-circle text-primary me-1"></i>
                                        <strong>Pause on rear rows:</strong> Hold camera steady for 2 seconds on back benches.
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-2 border rounded-2 bg-light">
                                        <i class="bi bi-arrow-right-circle text-primary me-1"></i>
                                        <strong>Frontal orientation:</strong> Advise students to face towards the lens during sweeps.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =================================================
                 MODAL 7: ATTENDANCE PREDICTION
            ================================================== -->
            <div class="modal fade" id="modalAttendancePrediction" tabindex="-1" aria-labelledby="modalAttendancePredictionLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header ai-modal-header">
                            <h6 class="modal-title fw-bold text-dark" id="modalAttendancePredictionLabel">
                                <i class="bi bi-graph-up-arrow text-primary me-2" style="color:#7c3aed !important;"></i> Attendance Prediction &amp; Trend Modeling
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border bg-light text-center">
                                        <div class="text-muted small">Improving Trend</div>
                                        <div class="fw-bold fs-4 text-success mt-1">{{ ai_features.attendance_prediction.improving_count if ai_features else 0 }}</div>
                                        <div class="small text-muted">Consecutive present sessions</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border bg-light text-center">
                                        <div class="text-muted small">Declining Trend</div>
                                        <div class="fw-bold fs-4 text-danger mt-1">{{ ai_features.attendance_prediction.declining_count if ai_features else 0 }}</div>
                                        <div class="small text-muted">Attendance dip observed</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border bg-light text-center">
                                        <div class="text-muted small">Projected Final Cohort</div>
                                        <div class="fw-bold fs-4 mt-1" style="color:#7c3aed;">{{ ai_features.attendance_prediction.projected_overall if ai_features else 0 }}%</div>
                                        <div class="small text-muted">Forecasted semester average</div>
                                    </div>
                                </div>
                            </div>

                            <h6 class="fw-bold text-dark mb-2">Students Likely to Fall Below 75% Criteria:</h6>
                            <div class="table-responsive mb-3">
                                <table class="table table-sm table-bordered align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Student Name</th>
                                            <th>USN</th>
                                            <th>Current %</th>
                                            <th>Forecasted Trajectory</th>
                                            <th>Risk Warning</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% if ai_features and ai_features.attendance_prediction.declining_sample %}
                                            {% for st in ai_features.attendance_prediction.declining_sample %}
                                            <tr>
                                                <td><strong>{{ st.name }}</strong></td>
                                                <td><code>{{ st.roll_no }}</code></td>
                                                <td><span class="badge bg-danger-subtle text-danger">{{ st.percentage }}%</span></td>
                                                <td><span class="text-danger"><i class="bi bi-arrow-down-right"></i> Declining</span></td>
                                                <td><span class="badge bg-warning text-dark">Below 75% Projected</span></td>
                                            </tr>
                                            {% endfor %}
                                        {% else %}
                                            <tr>
                                                <td colspan="5" class="text-center text-muted py-3">All students currently on track.</td>
                                            </tr>
                                        {% endif %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =================================================
                 MODAL 8: ELIGIBILITY PREDICTION
            ================================================== -->
            <div class="modal fade" id="modalEligibilityPrediction" tabindex="-1" aria-labelledby="modalEligibilityPredictionLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header ai-modal-header">
                            <h6 class="modal-title fw-bold text-dark" id="modalEligibilityPredictionLabel">
                                <i class="bi bi-calculator text-teal me-2" style="color:#0d9488 !important;"></i> 75% VTU Attendance Eligibility Analysis
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="p-3 bg-light rounded-3 border mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <span class="fw-bold text-dark">VTU University Regulation:</span>
                                    <span class="text-muted small d-block">Mandatory 75% attendance in each subject to appear for semester examination.</span>
                                </div>
                                <span class="badge bg-primary px-3 py-2">Threshold: 75.0%</span>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border bg-success-subtle border-success-subtle text-center">
                                        <div class="text-success fw-bold">Currently Eligible</div>
                                        <div class="fs-4 fw-bold text-success my-1">{{ ai_features.eligibility_prediction.eligible_count if ai_features else 0 }}</div>
                                        <div class="small text-success">&ge; 75% Maintained</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border bg-warning-subtle border-warning-subtle text-center">
                                        <div class="text-warning-emphasis fw-bold">Can Still Reach 75%</div>
                                        <div class="fs-4 fw-bold text-warning-emphasis my-1">{{ ai_features.eligibility_prediction.recoverable_count if ai_features else 0 }}</div>
                                        <div class="small text-muted">Recoverable with regular attendance</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 rounded-3 border bg-secondary-subtle text-center">
                                        <div class="text-dark fw-bold">Critical Ineligible Risk</div>
                                        <div class="fs-4 fw-bold text-dark my-1">{{ ai_features.eligibility_prediction.ineligible_risk_count if ai_features else 0 }}</div>
                                        <div class="small text-muted">Requires academic mentoring</div>
                                    </div>
                                </div>
                            </div>

                            <h6 class="fw-bold text-dark mb-2">Student Recovery Status (Remaining Sessions: {{ ai_features.eligibility_prediction.remaining_estimated_classes if ai_features else 0 }})</h6>
                            <div class="table-responsive mb-3">
                                <table class="table table-sm table-hover border align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Student Name</th>
                                            <th>USN</th>
                                            <th>Current %</th>
                                            <th>Classes Needed for 75%</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% if ai_features and ai_features.eligibility_prediction.recoverable_sample %}
                                            {% for st in ai_features.eligibility_prediction.recoverable_sample %}
                                            <tr>
                                                <td><strong>{{ st.name }}</strong></td>
                                                <td><code>{{ st.roll_no }}</code></td>
                                                <td><span class="badge bg-secondary-subtle text-dark border">{{ st.percentage }}%</span></td>
                                                <td><span class="fw-bold text-dark">{{ st.needed_present }}</span> present classes needed</td>
                                                <td><span class="badge bg-secondary-subtle text-dark border">Recoverable</span></td>
                                            </tr>
                                            {% endfor %}
                                        {% else %}
                                            <tr>
                                                <td colspan="5" class="text-center text-muted py-3">All students currently meet eligibility.</td>
                                            </tr>
                                        {% endif %}
                                    </tbody>
                                </table>
                            </div>

                            <div class="alert alert-light border py-2 small mb-0">
                                <i class="bi bi-info-circle me-1 text-primary"></i> <strong>Eligibility Calculation:</strong> Based on {{ ai_features.eligibility_prediction.remaining_estimated_classes if ai_features else 0 }} estimated remaining lectures in the semester. Minimum required present count is dynamically computed per student.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- =================================================
             4. ATTENDANCE ANALYTICS SECTION
        ================================================== -->
        <section id="analyticsSection" class="dashboard-section d-none">
            <!-- CHARTS ROW 1 -->
            <div class="row g-4 mb-4">
                <!-- CHART 1: PRESENT VS ABSENT -->
                <div class="col-lg-6 col-md-12">
                    <div class="chart-card">
                        <div class="chart-title">
                            <i class="bi bi-pie-chart-fill text-primary"></i> Overall Attendance Ratio
                        </div>
                        <div class="chart-subtitle">
                            Distribution of total present vs absent attendance instances.
                        </div>
                        <div class="chart-wrapper">
                            <canvas id="chartPresentAbsent"></canvas>
                        </div>
                    </div>
                </div>

                <!-- CHART 2: PERFORMANCE TIERS -->
                <div class="col-lg-6 col-md-12">
                    <div class="chart-card">
                        <div class="chart-title">
                            <i class="bi bi-diagram-2-fill text-success"></i> Student Attendance Tiers
                        </div>
                        <div class="chart-subtitle">
                            Student distribution across Regular (≥75%), Average (50-74%), and At-Risk (&lt;50%).
                        </div>
                        <div class="chart-wrapper">
                            <canvas id="chartTiers"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CHARTS ROW 2 -->
            <div class="row g-4 mb-4">
                <!-- CHART 3: ATTENDANCE TREND OVER TIME -->
                <div class="col-lg-7 col-md-12">
                    <div class="chart-card">
                        <div class="chart-title">
                            <i class="bi bi-graph-up text-info"></i> Attendance Trend Over Time
                        </div>
                        <div class="chart-subtitle">
                            Total student attendances logged per classroom video date.
                        </div>
                        <div class="chart-wrapper">
                            <canvas id="chartTrend"></canvas>
                        </div>
                    </div>
                </div>

                <!-- CHART 4: SUBJECT-WISE ATTENDANCE -->
                <div class="col-lg-5 col-md-12">
                    <div class="chart-card">
                        <div class="chart-title">
                            <i class="bi bi-book-half text-warning"></i> Subject-Wise Attendance
                        </div>
                        <div class="chart-subtitle">
                            Total present attendance logged across curriculum subjects.
                        </div>
                        <div class="chart-wrapper">
                            <canvas id="chartSubjects"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CHARTS ROW 3 -->
            <div class="row g-4">
                <!-- CHART 5: BRANCH & SECTION COMPARISON -->
                <div class="col-lg-12">
                    <div class="chart-card">
                        <div class="chart-title">
                            <i class="bi bi-bar-chart-steps text-purple" style="color: #8b5cf6;"></i>
                            Branch &amp; Section Attendance Comparison
                        </div>
                        <div class="chart-subtitle">
                            Comparative volume of student attendance across engineering branches and sections.
                        </div>
                        <div class="chart-wrapper" style="min-height: 260px;">
                            <canvas id="chartBranch"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- =================================================
             5. ATTENDANCE HISTORY SECTION
        ================================================== -->
        <section id="historySection" class="dashboard-section d-none">
            <div class="teacher-card">
                <div class="teacher-card-header">
                    <div>
                        <h5 class="teacher-card-title">
                            <i class="bi bi-clock-history me-2 text-primary"></i> Attendance History
                        </h5>
                        <div class="teacher-card-subtitle">
                            Complete historical record across all uploaded classroom sessions.
                        </div>
                    </div>
                    <span class="badge bg-light text-dark border px-3 py-2 fw-semibold" id="historyCountBadge">
                        {{ history_data|length if history_data else 0 }} Records
                    </span>
                </div>
                <div class="teacher-card-body">
                    <!-- ADVANCED MULTI-CRITERIA FILTERS -->
                    <div class="filter-section">
                        <div class="row g-3 align-items-end">
                            <!-- Semester -->
                            <div class="col-lg-2 col-md-4">
                                <label class="filter-label" for="historySemFilter">Semester</label>
                                <select class="filter-select" id="historySemFilter">
                                    <option value="">All Semesters</option>
                                    <option value="1">1st Semester</option>
                                    <option value="2">2nd Semester</option>
                                    <option value="3">3rd Semester</option>
                                    <option value="4">4th Semester</option>
                                    <option value="5">5th Semester</option>
                                    <option value="6">6th Semester</option>
                                    <option value="7">7th Semester</option>
                                    <option value="8">8th Semester</option>
                                </select>
                            </div>

                            <!-- Branch -->
                            <div class="col-lg-2 col-md-4">
                                <label class="filter-label" for="historyBranchFilter">Branch</label>
                                <select class="filter-select" id="historyBranchFilter">
                                    <option value="">All Branches</option>
                                    <option value="CSE (AIML)">CSE (AIML)</option>
                                    <option value="CSE">CSE</option>
                                    <option value="CSE (AIDS)">CSE (AIDS)</option>
                                    <option value="ECE">ECE</option>
                                    <option value="IS">IS</option>
                                </select>
                            </div>

                            <!-- Section -->
                            <div class="col-lg-2 col-md-4">
                                <label class="filter-label" for="historySectionFilter">Section</label>
                                <select class="filter-select" id="historySectionFilter">
                                    <option value="">All Sections</option>
                                    <option value="A">Section A</option>
                                    <option value="B">Section B</option>
                                    <option value="C">Section C</option>
                                </select>
                            </div>

                            <!-- Subject -->
                            <div class="col-lg-2 col-md-4">
                                <label class="filter-label" for="historySubjectFilter">Subject</label>
                                <select class="filter-select" id="historySubjectFilter">
                                    <option value="">All Subjects</option>
                                    {% for sub in subjects %}
                                    <option value="{{ sub.subject_name }}">{{ sub.subject_name }}</option>
                                    {% endfor %}
                                </select>
                            </div>

                            <!-- Date -->
                            <div class="col-lg-2 col-md-4">
                                <label class="filter-label" for="historyDateFilter">Date</label>
                                <input type="date" class="filter-input" id="historyDateFilter">
                            </div>

                            <!-- Search -->
                            <div class="col-lg-2 col-md-4">
                                <label class="filter-label" for="historySearchInput">Student / USN</label>
                                <input type="text" class="filter-input" id="historySearchInput" placeholder="Name or USN...">
                            </div>
                        </div>

                        <!-- Filter Actions -->
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearHistoryFilters()" style="border-radius: 8px; padding: 6px 14px;">
                                <i class="bi bi-x-circle me-1"></i> Clear Filters
                            </button>
                        </div>
                    </div>

                    {% set records_to_show = history_data if history_data else attendance_data %}
                    {% if records_to_show and records_to_show|length > 0 %}
                    <div class="attendance-table-wrap">
                        <table class="attendance-table" id="historyTable">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Date</th>
                                    <th>Student Name</th>
                                    <th>USN / Roll No</th>
                                    <th>Class Information</th>
                                    <th>Subject</th>
                                    <th>Status</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for record in records_to_show %}
                                <tr data-semester="{{ record.semester if record.semester else '' }}"
                                    data-branch="{{ record.branch|lower if record.branch else '' }}"
                                    data-section="{{ record.section|upper if record.section else '' }}"
                                    data-subject="{{ record.subject_name|lower if record.subject_name else '' }}"
                                    data-date="{{ record.date if record.date else '' }}">
                                    <td class="text-muted">{{ loop.index }}</td>
                                    <td>{{ record.date if record.date else now.strftime('%d-%m-%Y') }}</td>
                                    <td><strong>{{ record.name }}</strong></td>
                                    <td><code>{{ record.roll_no }}</code></td>
                                    <td><span class="badge bg-light text-dark border">{{ record.class_name if record.class_name else '7th Semester - CSE (AIML) - Section A' }}</span></td>
                                    <td>{{ record.subject_name if record.subject_name else 'General Lecture' }}</td>
                                    <td>
                                        <span class="status-{{ record.status }}">
                                            {% if record.status == 'present' %}
                                                <i class="bi bi-check-circle-fill"></i> Present
                                            {% else %}
                                                <i class="bi bi-x-circle-fill"></i> Absent
                                            {% endif %}
                                        </span>
                                    </td>
                                    <td>{{ record.time }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <div class="activity-empty">
                        <i class="bi bi-clock-history"></i>
                        <p class="fw-semibold text-dark">No attendance history records found.</p>
                        <p class="text-muted">Classroom attendance sessions will be logged here.</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </section>

        <!-- =================================================
             5B. PROCESSING HISTORY SECTION
        ================================================== -->
        <section id="processingHistorySection" class="dashboard-section d-none">
            <div class="teacher-card">
                <div class="teacher-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h5 class="teacher-card-title">
                            <i class="bi bi-camera-reels-fill text-primary me-2"></i> Classroom Video Processing History
                        </h5>
                        <div class="teacher-card-subtitle">
                            Chronological archive of classroom videos processed by the AI face recognition engine.
                        </div>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-semibold">
                        {{ processing_history|length if processing_history else 0 }} Videos Archived
                    </span>
                </div>
                <div class="teacher-card-body">
                    {% if processing_history and processing_history|length > 0 %}
                    <div class="attendance-table-wrap">
                        <table class="attendance-table" id="processingHistoryTable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Video File</th>
                                    <th>Uploaded / Processed</th>
                                    <th>Class Information</th>
                                    <th>Subject</th>
                                    <th>Faces Detected</th>
                                    <th>Recognized</th>
                                    <th>Processing Duration</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for video in processing_history %}
                                <tr>
                                    <td class="text-muted">{{ loop.index }}</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-file-earmark-play-fill text-primary fs-5"></i>
                                            <div>
                                                <div class="fw-semibold text-dark">{{ video.filename }}</div>
                                                <div class="text-muted small">ID: #{{ video.video_id }}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-dark">{{ video.processed_at if video.processed_at != 'N/A' else video.uploaded_at }}</div>
                                        <div class="text-muted" style="font-size: 0.74rem;">Uploaded: {{ video.uploaded_at }}</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">{{ video.class_name }}</span></td>
                                    <td><strong>{{ video.subject_name }}</strong></td>
                                    <td><span class="badge bg-light text-dark border fw-bold">{{ video.face_count }}</span></td>
                                    <td><span class="badge bg-success-subtle text-success fw-bold">{{ video.attendance_count }}</span></td>
                                    <td><span class="badge bg-light text-dark border">{{ video.duration }}</span></td>
                                    <td>
                                        {% if video.status == 'processed' %}
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Processed
                                        </span>
                                        {% else %}
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i> {{ video.status|capitalize }}
                                        </span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <div class="activity-empty">
                        <i class="bi bi-camera-reels text-muted"></i>
                        <p class="fw-semibold text-dark">No video processing history found.</p>
                        <p class="text-muted">Classroom videos uploaded will be archived here.</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </section>

        <!-- =================================================
             6. EXPORT SECTION
        ================================================== -->
        <section id="exportSection" class="dashboard-section d-none">
            <div class="teacher-card">
                <div class="teacher-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h5 class="teacher-card-title">
                            <i class="bi bi-file-earmark-spreadsheet-fill me-2 text-primary"></i> Export Reports
                        </h5>
                        <div class="teacher-card-subtitle">Download records in Microsoft Excel (.xlsx) or printable PDF document formats.</div>
                    </div>
                    <span class="badge bg-secondary-subtle text-dark border px-3 py-2 fw-semibold" id="exportRecordCountBadge">
                        {{ students_list|length if students_list else 0 }} Records Selected
                    </span>
                </div>
                <div class="teacher-card-body">
                    <!-- FILTER CONTROLS FOR EXPORT -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                            <span class="fw-bold text-dark small">
                                <i class="bi bi-funnel me-1"></i> Filter Attendance Records for Export
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="resetExportFilters()">
                                Reset Filters
                            </button>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4 col-12">
                                <label class="filter-label">Class</label>
                                <select class="filter-select" id="exportClassFilter" onchange="applyExportFilters()">
                                    <option value="" selected>All Classes</option>
                                    {% for c in classes %}
                                    <option value="{{ c.class_id }}">{{ c.class_name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-4 col-6">
                                <label class="filter-label">Semester</label>
                                <select class="filter-select" id="exportSemFilter" onchange="applyExportFilters()">
                                    <option value="" selected>All Semesters</option>
                                    <option value="1">1st Semester</option>
                                    <option value="2">2nd Semester</option>
                                    <option value="3">3rd Semester</option>
                                    <option value="4">4th Semester</option>
                                    <option value="5">5th Semester</option>
                                    <option value="6">6th Semester</option>
                                    <option value="7">7th Semester</option>
                                    <option value="8">8th Semester</option>
                                </select>
                            </div>
                            <div class="col-md-4 col-6">
                                <label class="filter-label">Subject</label>
                                <select class="filter-select" id="exportSubjectFilter" onchange="applyExportFilters()">
                                    <option value="" selected>All Subjects</option>
                                    {% for sub in subjects %}
                                    <option value="{{ sub.subject_name }}">{{ sub.subject_name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- EXPORT FORMAT OPTIONS -->
                    <div class="row g-4">
                        <!-- EXCEL FORMAT CARD (NO CSV) -->
                        <div class="col-md-6">
                            <div class="p-4 rounded-3 border bg-white text-center h-100 d-flex flex-column justify-content-between shadow-sm">
                                <div>
                                    <div class="d-inline-flex p-3 rounded-circle bg-light border mb-3">
                                        <i class="bi bi-file-earmark-excel text-success" style="font-size: 2.2rem;"></i>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-1">Microsoft Excel Format (.xlsx)</h6>
                                    <p class="text-muted small mb-3">
                                        Generates a genuine Microsoft Excel (.xlsx) spreadsheet workbook with student USNs, names, class, attended count, total sessions, and attendance percentage.
                                    </p>
                                </div>
                                <div>
                                    <button type="button" class="btn btn-primary w-100 py-2 fw-semibold" onclick="downloadExcel()">
                                        <i class="bi bi-download me-1"></i> Download Excel (.xlsx)
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- PDF FORMAT CARD -->
                        <div class="col-md-6">
                            <div class="p-4 rounded-3 border bg-white text-center h-100 d-flex flex-column justify-content-between shadow-sm">
                                <div>
                                    <div class="d-inline-flex p-3 rounded-circle bg-light border mb-3">
                                        <i class="bi bi-file-earmark-pdf text-danger" style="font-size: 2.2rem;"></i>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-1">PDF Document (.pdf)</h6>
                                    <p class="text-muted small mb-3">
                                        Generates a formatted printable attendance document with institutional letterhead, student attendance table, and department summary.
                                    </p>
                                </div>
                                <div>
                                    <button type="button" class="btn btn-outline-secondary w-100 py-2 fw-semibold text-dark border" onclick="downloadPDF()">
                                        <i class="bi bi-printer me-1"></i> Print / Save PDF
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- =================================================
             6B. EMAIL ATTENDANCE DISPATCH SECTION
        ================================================== -->
                <!-- =================================================
             6B. REAL-TIME STUDENT EMAIL ATTENDANCE DISPATCH
        ================================================== -->
        <section id="emailSection" class="dashboard-section d-none">
            <div class="teacher-card">
                <div class="teacher-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h5 class="teacher-card-title">
                            <i class="bi bi-envelope-at-fill text-primary me-2"></i> Student Attendance Email Notifications
                        </h5>
                        <div class="teacher-card-subtitle">
                            Send real-time attendance reports and low attendance warnings directly to students' registered email addresses.
                        </div>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-semibold">
                        <i class="bi bi-send-fill me-1"></i> Real-Time Student Email Dispatch
                    </span>
                </div>
                <div class="teacher-card-body">

                    <!-- Notification Type Selection Tabs -->
                    <ul class="nav nav-pills mb-4" id="studentEmailTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="tabWeeklyBtn" onclick="switchEmailMode('weekly', this)" type="button">
                                <i class="bi bi-calendar-week me-1"></i> Weekly Attendance Update
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tabShortageBtn" onclick="switchEmailMode('shortage', this)" type="button">
                                <i class="bi bi-exclamation-triangle-fill me-1 text-danger"></i> Low Attendance Warning (Below 75%)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tabMonthlyBtn" onclick="switchEmailMode('monthly', this)" type="button">
                                <i class="bi bi-calendar-month me-1"></i> Monthly Attendance Summary
                            </button>
                        </li>
                    </ul>

                    <!-- FILTER PARAMETERS CARD -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold text-dark mb-0" id="filterCardTitle">
                                <i class="bi bi-funnel me-1 text-primary"></i> Step 1: Select Academic Class &amp; Parameters
                            </h6>
                            <span class="badge bg-white text-muted border px-2 py-1 small" id="activeModeBadge">Mode: Weekly Update</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-2 col-6">
                                <label class="filter-label">Semester</label>
                                <select class="filter-select" id="emailSemFilter" onchange="filterStudentsForEmail()">
                                    <option value="7" selected>7th Semester</option>
                                    <option value="6">6th Semester</option>
                                    <option value="8">8th Semester</option>
                                </select>
                            </div>
                            <div class="col-md-3 col-6">
                                <label class="filter-label">Branch</label>
                                <select class="filter-select" id="emailBranchFilter" onchange="filterStudentsForEmail()">
                                    <option value="CSE (AIML)" selected>CSE (AIML)</option>
                                    <option value="CSE">CSE</option>
                                    <option value="ECE">ECE</option>
                                </select>
                            </div>
                            <div class="col-md-2 col-6">
                                <label class="filter-label">Section</label>
                                <select class="filter-select" id="emailSecFilter" onchange="filterStudentsForEmail()">
                                    <option value="A" selected>Section A</option>
                                    <option value="B">Section B</option>
                                </select>
                            </div>
                            <div class="col-md-3 col-6">
                                <label class="filter-label">Subject</label>
                                <select class="filter-select" id="emailSubFilter" onchange="filterStudentsForEmail()">
                                    <option value="All Subjects" selected>All Subjects</option>
                                    {% for sub in subjects %}
                                    <option value="{{ sub.subject_name }}">{{ sub.subject_name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-2 col-12" id="dateFilterCol">
                                <label class="filter-label" id="dateFilterLabel">Week / Date</label>
                                <input type="date" class="filter-input" id="emailDateFilter" value="2026-09-01" onchange="filterStudentsForEmail()">
                            </div>
                        </div>
                    </div>

                    <!-- STEP 2: STUDENT SELECTION TABLE -->
                    <div class="p-3 border rounded-3 mb-4 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 border-bottom pb-2">
                            <div>
                                <h6 class="fw-bold text-dark mb-0">
                                    <i class="bi bi-people-fill text-primary me-1"></i> Step 2: Select Students to Receive Email
                                </h6>
                                <div class="text-muted small">Choose individual students or use the quick buttons below.</div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary px-3 py-2 fs-7" id="selectedCountBadge">
                                    0 Students Selected
                                </span>
                            </div>
                        </div>

                        <!-- Quick Selection Toolbar -->
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="selectAllStudents(true)">
                                <i class="bi bi-check-all me-1"></i> Select All
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="selectAllStudents(false)">
                                <i class="bi bi-dash-circle me-1"></i> Deselect All
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="selectLowAttendanceStudentsOnly()">
                                <i class="bi bi-exclamation-circle me-1"></i> Select Low Attendance Only (&lt; 75%)
                            </button>
                        </div>

                        <!-- Table -->
                        <div class="table-responsive mb-2" style="max-height: 320px; overflow-y: auto;">
                            <table class="table table-hover align-middle mb-0" id="studentEmailSelectionTable">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 40px;">
                                            <input type="checkbox" class="form-check-input" id="selectAllCheckbox" onchange="toggleSelectAllCheckbox(this)" checked>
                                        </th>
                                        <th>Student Name</th>
                                        <th>USN</th>
                                        <th>Student Email Address</th>
                                        <th>Classes Attended</th>
                                        <th>Attendance %</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody id="studentEmailSelectionTbody">
                                    <!-- Populated dynamically via JavaScript -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- STEP 3: CUSTOMIZE EMAIL SUBJECT & FRIENDLY MESSAGE -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <h6 class="fw-bold text-dark mb-2">
                            <i class="bi bi-pencil-square text-primary me-1"></i> Step 3: Customize Email Subject &amp; Teacher Note
                        </h6>
                        <div class="text-muted small mb-3">
                            Natural, friendly message sent directly to each selected student's email inbox.
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Email Subject</label>
                            <input type="text" class="form-control teacher-form-control" id="emailSubjectInput" value="Weekly Attendance Update - 7th Semester CSE (AIML)">
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Teacher's Note / Remarks (in simple, easy English)</label>
                            <textarea class="form-control teacher-form-control" id="emailMessageInput" rows="3">Please find your weekly attendance update. Keep attending classes regularly to stay on track with your coursework. If you have any doubts, feel free to meet me after class.</textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-2 border-top">
                            <div class="small text-muted">
                                <i class="bi bi-person-badge text-primary me-1"></i> Sender: <strong>{{ name or 'Teacher' }}</strong> (GSSS Department of CSE AIML)
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="previewSampleStudentEmail()">
                                    <i class="bi bi-eye me-1"></i> Preview Sample Email
                                </button>
                                <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm" id="btnSendStudentEmails" onclick="dispatchStudentEmailsRealtime()">
                                    <i class="bi bi-send-fill me-1"></i> Send Real-Time Email to <span id="btnSelectedCount">0</span> Students
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 4: REAL-TIME DISPATCH PROGRESS & AUDIT LOG -->
                    <div id="emailDispatchAuditBlock" class="p-3 border rounded-3 bg-white d-none">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="fw-bold text-dark mb-0" id="dispatchProgressTitle">
                                    <i class="bi bi-broadcast text-success me-1"></i> Real-Time Dispatch Status
                                </h6>
                                <div class="text-muted small" id="dispatchProgressSubtitle">Sending attendance emails to students...</div>
                            </div>
                            <span class="badge bg-success rounded-pill px-3 py-2" id="dispatchStatusBadge">In Progress</span>
                        </div>

                        <!-- Progress Bar -->
                        <div class="progress mb-3" style="height: 10px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" id="emailProgressBar" style="width: 0%;"></div>
                        </div>

                        <!-- Results List -->
                        <div class="p-3 bg-light rounded-3 border" style="max-height: 220px; overflow-y: auto;">
                            <div id="emailDispatchResultsList" class="d-flex flex-column gap-2 small">
                                <!-- Populated dynamically as emails are sent -->
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- =================================================
             6C. NOTIFICATION CENTER SECTION
        ================================================== -->
        <section id="notificationsSection" class="dashboard-section d-none">
            <div class="teacher-card">
                <div class="teacher-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h5 class="teacher-card-title">
                            <i class="bi bi-bell-fill text-primary me-2"></i> Notification Center
                        </h5>
                        <div class="teacher-card-subtitle">Real-time alerts, processing confirmations, and attendance shortage notifications.</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fw-semibold" id="notifCenterBadge">
                            {{ notifications_list|selectattr('read', 'equalto', false)|list|length if notifications_list else 0 }} Unread Alerts
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="markAllNotifsAsRead()">
                            <i class="bi bi-check2-all me-1"></i> Mark All as Read
                        </button>
                    </div>
                </div>
                <div class="teacher-card-body">
                    <!-- Notification Filter Tabs -->
                    <div class="d-flex gap-2 mb-3 flex-wrap align-items-center">
                        <span class="text-muted small fw-semibold me-1">Filter Alerts:</span>
                        <button type="button" class="btn btn-sm btn-primary filter-notif-btn active" id="btnNotifAll" onclick="filterNotifs('all')">All (<span id="countNotifAll">{{ notifications_list|length if notifications_list else 0 }}</span>)</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary filter-notif-btn" id="btnNotifShortage" onclick="filterNotifs('shortage')">Shortage Alerts</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary filter-notif-btn" id="btnNotifProcessing" onclick="filterNotifs('processing')">Video Processing</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary filter-notif-btn" id="btnNotifVerification" onclick="filterNotifs('verification')">Verification</button>
                    </div>

                    <div class="list-group list-group-flush border rounded-3" id="notificationsListGroup">
                        {% if notifications_list and notifications_list|length > 0 %}
                            {% for notif in notifications_list %}
                            <div class="list-group-item p-3 d-flex justify-content-between align-items-start gap-3 notif-item {% if not notif.read %}bg-light{% endif %}" id="notif_{{ notif.id }}" data-type="{{ notif.type }}" data-read="{{ 'true' if notif.read else 'false' }}">
                                <div class="d-flex gap-3">
                                    <div class="p-2 rounded-circle {% if notif.type == 'shortage' %}bg-danger-subtle text-danger{% elif notif.type == 'processing' %}bg-success-subtle text-success{% elif notif.type == 'verification' %}bg-warning-subtle text-warning{% else %}bg-primary-subtle text-primary{% endif %}" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                        <i class="bi {% if notif.type == 'shortage' %}bi-exclamation-triangle-fill{% elif notif.type == 'processing' %}bi-camera-video-fill{% elif notif.type == 'verification' %}bi-shield-exclamation{% else %}bi-info-circle-fill{% endif %}"></i>
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold text-dark">{{ notif.title }}</span>
                                            <span class="badge {{ notif.badge_class }} small">{{ notif.badge }}</span>
                                            {% if not notif.read %}
                                            <span class="badge bg-danger rounded-pill" style="font-size: 0.65rem;" id="unreadDot_{{ notif.id }}">NEW</span>
                                            {% endif %}
                                        </div>
                                        <div class="text-muted small mt-1" style="line-height: 1.5;">{{ notif.message }}</div>
                                        <div class="text-muted" style="font-size: 0.72rem; margin-top: 4px;">{{ notif.time }}</div>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Mark as Read" onclick="markNotifAsRead({{ notif.id }})">
                                    <i class="bi bi-check2"></i>
                                </button>
                            </div>
                            {% endfor %}
                        {% else %}
                            <div class="p-4 text-center text-muted">No notifications at this time.</div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </section>

                <!-- STUDENT EMAIL PREVIEW MODAL -->
        <div class="modal fade" id="modalEmailPreview" tabindex="-1" aria-labelledby="modalEmailPreviewLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-light border-bottom">
                        <h6 class="modal-title fw-bold text-dark" id="modalEmailPreviewLabel">
                            <i class="bi bi-envelope-paper-fill text-primary me-2"></i> Sample Student Email Preview
                        </h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4" style="background-color: #f8fafc;">
                        <div class="p-3 bg-white rounded-3 border mb-3 shadow-sm">
                            <div class="small text-muted mb-1"><strong>To:</strong> <span id="modalPreviewToEmail">adinaduthota@gmail.com</span> (Student)</div>
                            <div class="small text-muted mb-1"><strong>From:</strong> GSSS Attendance Portal &lt;attendance-notifications@gsss.edu.in&gt;</div>
                            <div class="small text-dark"><strong>Subject:</strong> <span id="modalPreviewSubject">Weekly Attendance Update</span></div>
                        </div>

                        <!-- Sample rendered card -->
                        <div class="p-4 bg-white rounded-3 border shadow-sm">
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                                <div>
                                    <div class="small text-uppercase fw-bold text-primary">GSSS Institute of Engineering &amp; Technology</div>
                                    <h5 class="fw-bold text-dark mb-0" id="modalPreviewHeaderTitle">Weekly Attendance Update</h5>
                                    <div class="text-muted small">Department of CSE (Artificial Intelligence &amp; Machine Learning)</div>
                                </div>
                                <span class="badge bg-light text-dark border px-2 py-1 small">Official Notification</span>
                            </div>

                            <p class="text-dark" id="modalPreviewGreeting">
                                Dear <strong>Aditi Naduthota</strong>,<br>
                                Here is your verified attendance update for 7th Semester - CSE (AIML).
                            </p>

                            <div class="p-3 bg-light rounded-3 border mb-3">
                                <div class="row text-center g-2">
                                    <div class="col-4 border-end">
                                        <div class="text-muted small text-uppercase">Classes Held</div>
                                        <div class="fs-4 fw-bold text-dark" id="modalPreviewHeld">48</div>
                                    </div>
                                    <div class="col-4 border-end">
                                        <div class="text-muted small text-uppercase">Attended</div>
                                        <div class="fs-4 fw-bold text-success" id="modalPreviewAttended">19</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="text-muted small text-uppercase">Attendance %</div>
                                        <div class="fs-4 fw-bold" id="modalPreviewPct" style="color: #d97706;">39.6%</div>
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-light border small text-dark mb-3" id="modalPreviewStatusNote">
                                Please check your attended classes and keep maintaining regular attendance.
                            </div>

                            <div class="p-3 bg-light rounded-2 border small" id="modalPreviewRemarksBox">
                                <strong>Teacher's Note:</strong> <span id="modalPreviewTeacherNote">Keep up the good work!</span>
                            </div>

                            <div class="mt-3 pt-3 border-top small text-muted">
                                Warm regards,<br>
                                <strong>{{ name or 'Teacher' }}</strong><br>
                                GSSS Institute of Engineering &amp; Technology, Mysuru
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 bg-light">
                        <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Close Preview</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- =================================================
             7. TEACHER PROFILE SECTION
        ================================================== -->
        <section id="profileSection" class="dashboard-section d-none">
            <div class="teacher-card">
                <div class="teacher-card-header">
                    <div>
                        <h5 class="teacher-card-title">
                            <i class="bi bi-person-circle me-2 text-primary"></i> Teacher Profile
                        </h5>
                        <div class="teacher-card-subtitle">Account details and role credentials.</div>
                    </div>
                </div>
                <div class="teacher-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control teacher-form-control"
                                value="{{ name or session.get('name') or 'Teacher' }}" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Role</label>
                            <input type="text" class="form-control teacher-form-control" value="Teacher" readonly>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </main>
</div>

<!-- =========================================================
     CHART.JS LIBRARY FOR RESPONSIVE ANALYTICS
========================================================= -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<script>
/* =========================================================
   EXPORT FUNCTIONALITY (GENUINE EXCEL .XLSX & FORMATTED PDF)
========================================================= */
function getFilteredExportData() {
    const classId = (document.getElementById('exportClassFilter')?.value || '').trim();
    const sem = (document.getElementById('exportSemFilter')?.value || '').trim();
    const sub = (document.getElementById('exportSubjectFilter')?.value || '').trim();

    return studentsDataset.filter(function(s) {
        const matchClass = !classId || String(s.class_id || '') === String(classId);
        const matchSem = !sem || String(s.semester || '') === String(sem);
        return matchClass && matchSem;
    });
}

function applyExportFilters() {
    const filtered = getFilteredExportData();
    const badge = document.getElementById('exportRecordCountBadge');
    if (badge) {
        badge.textContent = `${filtered.length} Records Selected`;
    }
}

function resetExportFilters() {
    const cEl = document.getElementById('exportClassFilter');
    const sEl = document.getElementById('exportSemFilter');
    const subEl = document.getElementById('exportSubjectFilter');
    if (cEl) cEl.value = '';
    if (sEl) sEl.value = '';
    if (subEl) subEl.value = '';
    applyExportFilters();
}

function downloadExcel() {
    const filtered = getFilteredExportData();
    if (!filtered || filtered.length === 0) {
        alert('No attendance data available for the selected filters.');
        return;
    }

    const classEl = document.getElementById('exportClassFilter');
    const selectedClassName = (classEl && classEl.selectedIndex > 0) ? classEl.options[classEl.selectedIndex].text : 'All Classes';
    const semVal = document.getElementById('exportSemFilter')?.value ? `${document.getElementById('exportSemFilter').value}th Semester` : 'All Semesters';
    const subVal = document.getElementById('exportSubjectFilter')?.value || 'All Subjects';
    const now = new Date();
    const dateStr = now.getFullYear() +
        String(now.getMonth() + 1).padStart(2, '0') +
        String(now.getDate()).padStart(2, '0');

    if (typeof XLSX !== 'undefined') {
        const wb = XLSX.utils.book_new();
        const wsData = [
            ["GSSS INSTITUTE OF ENGINEERING & TECHNOLOGY"],
            ["Department of Computer Science & Engineering (AIML)"],
            ["OFFICIAL CLASSROOM ATTENDANCE REPORT"],
            [],
            ["Filter Details:", `Class: ${selectedClassName}`, `Semester: ${semVal}`, `Subject: ${subVal}`],
            ["Generated Date:", now.toLocaleString(), "", "Generated By:", "{{ name or session.get('name') or 'Teacher' }}"],
            [],
            ["SL No", "Student Name", "USN / Roll No", "Class / Section", "Classes Attended", "Total Classes", "Attendance %", "Eligibility Status"]
        ];

        filtered.forEach(function(s, idx) {
            wsData.push([
                idx + 1,
                s.name,
                s.roll_no,
                `${s.semester}th Sem ${s.branch} Sec ${s.section}`,
                s.attended_count || 0,
                s.total_sessions || 0,
                `${s.percentage}%`,
                s.percentage >= 75 ? "Eligible" : "Attendance Shortage"
            ]);
        });

        const ws = XLSX.utils.aoa_to_sheet(wsData);
        ws['!cols'] = [
            { wch: 8 },
            { wch: 26 },
            { wch: 18 },
            { wch: 30 },
            { wch: 16 },
            { wch: 14 },
            { wch: 15 },
            { wch: 22 }
        ];
        XLSX.utils.book_append_sheet(wb, ws, "Attendance Report");
        XLSX.writeFile(wb, `attendance_report_${dateStr}.xlsx`);
    } else {
        let excelXml = '<?xml version="1.0"?>\n' +
            '<?mso-application progid="Excel.Sheet"?>\n' +
            '<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"\n' +
            ' xmlns:o="urn:schemas-microsoft-com:office:office"\n' +
            ' xmlns:x="urn:schemas-microsoft-com:office:excel"\n' +
            ' xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">\n' +
            '<Styles>\n' +
            ' <Style ss:ID="Header"><Font ss:Bold="1"/><Interior ss:Color="#E2E8F0" ss:Pattern="Solid"/></Style>\n' +
            ' <Style ss:ID="Title"><Font ss:Bold="1" ss:Size="14"/></Style>\n' +
            '</Styles>\n' +
            '<Worksheet ss:Name="Attendance Report">\n' +
            '<Table>\n' +
            '<Row><Cell ss:StyleID="Title"><Data ss:Type="String">GSSS Institute of Engineering &amp; Technology</Data></Cell></Row>\n' +
            `<Row><Cell><Data ss:Type="String">Attendance Report - Class: ${selectedClassName}, Sem: ${semVal}, Subject: ${subVal}</Data></Cell></Row>\n` +
            '<Row><Cell><Data ss:Type="String"></Data></Cell></Row>\n' +
            '<Row ss:StyleID="Header">\n' +
            ' <Cell><Data ss:Type="String">SL No</Data></Cell>\n' +
            ' <Cell><Data ss:Type="String">Student Name</Data></Cell>\n' +
            ' <Cell><Data ss:Type="String">USN / Roll No</Data></Cell>\n' +
            ' <Cell><Data ss:Type="String">Classes Attended</Data></Cell>\n' +
            ' <Cell><Data ss:Type="String">Total Classes</Data></Cell>\n' +
            ' <Cell><Data ss:Type="String">Attendance %</Data></Cell>\n' +
            ' <Cell><Data ss:Type="String">Status</Data></Cell>\n' +
            '</Row>\n';

        filtered.forEach(function(s, idx) {
            excelXml += '<Row>\n' +
                ` <Cell><Data ss:Type="Number">${idx + 1}</Data></Cell>\n` +
                ` <Cell><Data ss:Type="String">${s.name}</Data></Cell>\n` +
                ` <Cell><Data ss:Type="String">${s.roll_no}</Data></Cell>\n` +
                ` <Cell><Data ss:Type="Number">${s.attended_count || 0}</Data></Cell>\n` +
                ` <Cell><Data ss:Type="Number">${s.total_sessions || 0}</Data></Cell>\n` +
                ` <Cell><Data ss:Type="String">${s.percentage}%</Data></Cell>\n` +
                ` <Cell><Data ss:Type="String">${s.percentage >= 75 ? 'Eligible' : 'Shortage'}</Data></Cell>\n` +
                '</Row>\n';
        });

        excelXml += '</Table>\n</Worksheet>\n</Workbook>';

        const blob = new Blob([excelXml], { type: 'application/vnd.ms-excel' });
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `attendance_report_${dateStr}.xls`;
        a.click();
        window.URL.revokeObjectURL(url);
    }
}

function downloadPDF() {
    const filtered = getFilteredExportData();
    if (!filtered || filtered.length === 0) {
        alert('No attendance data available for the selected filters.');
        return;
    }

    const printWindow = window.open('', '_blank', 'width=900,height=700');
    if (!printWindow) {
        alert('Please allow popups to print/export PDF.');
        return;
    }

    const classEl = document.getElementById('exportClassFilter');
    const selectedClassName = (classEl && classEl.selectedIndex > 0) ? classEl.options[classEl.selectedIndex].text : 'All Classes';
    const semVal = document.getElementById('exportSemFilter')?.value ? `${document.getElementById('exportSemFilter').value}th Semester` : 'All Semesters';
    const subVal = document.getElementById('exportSubjectFilter')?.value || 'All Subjects';
    const now = new Date();

    const eligibleCount = filtered.filter(s => Number(s.percentage || 0) >= 75).length;
    const shortageCount = filtered.filter(s => Number(s.percentage || 0) < 75).length;

    let rowsHtml = '';
    filtered.forEach(function(s, idx) {
        const isEligible = Number(s.percentage || 0) >= 75;
        const statusBadge = isEligible
            ? '<span style="color:#059669;font-weight:600;">Eligible</span>'
            : '<span style="color:#dc2626;font-weight:600;">Shortage (&lt;75%)</span>';
        rowsHtml += `
            <tr>
                <td style="text-align:center;">${idx + 1}</td>
                <td><strong>${s.name}</strong></td>
                <td><code>${s.roll_no}</code></td>
                <td>${s.semester}th Sem ${s.branch} - Sec ${s.section}</td>
                <td style="text-align:center;">${s.attended_count || 0} / ${s.total_sessions || 0}</td>
                <td style="text-align:center;font-weight:600;">${s.percentage}%</td>
                <td style="text-align:center;">${statusBadge}</td>
            </tr>
        `;
    });

    printWindow.document.write(`
        <!DOCTYPE html>
        <html>
            <head>
                <title>Attendance Report - ${selectedClassName}</title>
                <style>
                    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; padding: 30px; color: #0f172a; margin: 0; }
                    .header { border-bottom: 2px solid #0f172a; padding-bottom: 15px; margin-bottom: 20px; }
                    .header h2 { margin: 0 0 5px 0; font-size: 20px; text-transform: uppercase; letter-spacing: 0.5px; }
                    .header h4 { margin: 0 0 8px 0; font-size: 14px; color: #475569; font-weight: 500; }
                    .meta-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 6px; font-size: 12px; margin-bottom: 20px; }
                    .meta-item strong { display: block; color: #64748b; text-transform: uppercase; font-size: 10px; margin-bottom: 2px; }
                    .summary-row { display: flex; gap: 15px; margin-bottom: 20px; }
                    .summary-box { flex: 1; padding: 10px; border-radius: 6px; border: 1px solid #e2e8f0; background: #f8fafc; text-align: center; }
                    .summary-box .val { font-size: 18px; font-weight: bold; margin-top: 2px; }
                    table { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 30px; }
                    th { background: #f1f5f9; border: 1px solid #cbd5e1; padding: 8px; text-align: left; font-weight: 600; }
                    td { border: 1px solid #cbd5e1; padding: 7px 8px; }
                    tr:nth-child(even) { background: #fafafa; }
                    .footer { display: flex; justify-content: space-between; margin-top: 40px; font-size: 12px; }
                    .signature-box { text-align: center; width: 200px; border-top: 1px solid #000; padding-top: 5px; }
                    @media print {
                        body { padding: 10px; }
                    }
                </style>
            </head>
            <body>
                <div class="header">
                    <h2>GSSS Institute of Engineering &amp; Technology</h2>
                    <h4>Department of Computer Science &amp; Engineering</h4>
                    <div style="font-size: 13px; font-weight: 600; color: #1e293b;">OFFICIAL CLASSROOM ATTENDANCE REPORT</div>
                </div>

                <div class="meta-grid">
                    <div class="meta-item"><strong>Class</strong>${selectedClassName}</div>
                    <div class="meta-item"><strong>Semester</strong>${semVal}</div>
                    <div class="meta-item"><strong>Subject</strong>${subVal}</div>
                    <div class="meta-item"><strong>Date</strong>${now.toLocaleDateString()}</div>
                </div>

                <div class="summary-row">
                    <div class="summary-box">
                        <div style="font-size: 11px; color:#64748b;">Total Students</div>
                        <div class="val">${filtered.length}</div>
                    </div>
                    <div class="summary-box">
                        <div style="font-size: 11px; color:#64748b;">Eligible (&ge;75%)</div>
                        <div class="val" style="color:#059669;">${eligibleCount}</div>
                    </div>
                    <div class="summary-box">
                        <div style="font-size: 11px; color:#64748b;">Shortage (&lt;75%)</div>
                        <div class="val" style="color:#dc2626;">${shortageCount}</div>
                    </div>
                </div>

                <table>
                    <thead>
                        <tr>
                            <th style="width: 40px; text-align: center;">#</th>
                            <th>Student Name</th>
                            <th>USN / Roll No</th>
                            <th>Class / Section</th>
                            <th style="text-align: center;">Attended</th>
                            <th style="text-align: center;">Percentage</th>
                            <th style="text-align: center;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${rowsHtml}
                    </tbody>
                </table>

                <div class="footer">
                    <div>Generated by: <strong>{{ name or session.get('name') or 'Teacher' }}</strong> (${now.toLocaleTimeString()})</div>
                    <div class="signature-box">Faculty In-Charge Signature</div>
                </div>

                <script>
                    window.onload = function() {
                        window.print();
                    };
                <\/script>
            </body>
        </html>
    `);
    printWindow.document.close();
}

function refreshData() {
    window.location.reload();
}

/* =========================================================
   STUDENTS DIRECTORY FILTERS
========================================================= */
function applyStudentFilters() {
    const branchVal = (document.getElementById('studentBranchFilter')?.value || '').toLowerCase().trim();
    const sectionVal = (document.getElementById('studentSectionFilter')?.value || '').toLowerCase().trim();
    const searchVal = (document.getElementById('studentSearchInput')?.value || '').toLowerCase().trim();
    const rows = document.querySelectorAll('#studentsTable tbody tr');
    let visibleCount = 0;

    rows.forEach(function(row) {
        const rowBranch = (row.dataset.branch || '').toLowerCase();
        const rowSection = (row.dataset.section || '').toLowerCase();
        const rowText = row.textContent.toLowerCase();

        let matchesBranch = !branchVal;
        if (branchVal) {
            if (branchVal.includes('aiml') || branchVal === 'cse (aiml)') {
                matchesBranch = rowBranch.includes('aiml');
            } else {
                matchesBranch = rowBranch.includes(branchVal);
            }
        }

        const matchesSection = !sectionVal || rowSection === sectionVal;
        const matchesSearch = !searchVal || rowText.includes(searchVal);

        if (matchesBranch && matchesSection && matchesSearch) {
            row.style.display = '';
            visibleCount++;
        } else {
            row.style.display = 'none';
        }
    });

    const badge = document.getElementById('studentsCountBadge');
    if (badge) {
        badge.textContent = `Showing ${visibleCount} Students`;
    }

    const emptyState = document.getElementById('studentsEmptyState');
    const tableWrap = document.getElementById('studentsTableWrap');
    if (emptyState && tableWrap) {
        if (visibleCount === 0) {
            emptyState.classList.remove('d-none');
            tableWrap.classList.add('d-none');
        } else {
            emptyState.classList.add('d-none');
            tableWrap.classList.remove('d-none');
        }
    }
}

function viewAllStudents() {
    const bEl = document.getElementById('studentBranchFilter');
    const sEl = document.getElementById('studentSectionFilter');
    const qEl = document.getElementById('studentSearchInput');
    if (bEl) bEl.value = '';
    if (sEl) sEl.value = '';
    if (qEl) qEl.value = '';
    applyStudentFilters();
}

function resetStudentFilters() {
    viewAllStudents();
}

/* =========================================================
   ATTENDANCE HISTORY FILTERS
========================================================= */
function applyHistoryFilters() {
    const semVal = (document.getElementById('historySemFilter')?.value || '').trim();
    const branchVal = (document.getElementById('historyBranchFilter')?.value || '').toLowerCase().trim();
    const secVal = (document.getElementById('historySectionFilter')?.value || '').toLowerCase().trim();
    const subVal = (document.getElementById('historySubjectFilter')?.value || '').toLowerCase().trim();
    const dateVal = (document.getElementById('historyDateFilter')?.value || '').trim();
    const searchVal = (document.getElementById('historySearchInput')?.value || '').toLowerCase().trim();

    const rows = document.querySelectorAll('#historyTable tbody tr');
    let visibleCount = 0;

    rows.forEach(function(row) {
        const rowSem = (row.dataset.semester || '').trim();
        const rowBranch = (row.dataset.branch || '').toLowerCase();
        const rowSec = (row.dataset.section || '').toLowerCase();
        const rowSub = (row.dataset.subject || '').toLowerCase();
        const rowDate = (row.dataset.date || '').trim();
        const rowText = row.textContent.toLowerCase();

        let matchesSem = !semVal || rowSem === semVal;
        let matchesBranch = !branchVal;
        if (branchVal) {
            if (branchVal.includes('aiml') || branchVal === 'cse (aiml)') {
                matchesBranch = rowBranch.includes('aiml');
            } else {
                matchesBranch = rowBranch.includes(branchVal);
            }
        }
        let matchesSec = !secVal || rowSec === secVal;
        let matchesSub = !subVal || rowSub.includes(subVal);

        let matchesDate = true;
        if (dateVal) {
            const parts = dateVal.split('-');
            if (parts.length === 3) {
                const formattedPicker = `${parts[2]}-${parts[1]}-${parts[0]}`;
                matchesDate = rowDate === formattedPicker;
            }
        }
        const matchesSearch = !searchVal || rowText.includes(searchVal);

        if (matchesSem && matchesBranch && matchesSec && matchesSub && matchesDate && matchesSearch) {
            row.style.display = '';
            visibleCount++;
        } else {
            row.style.display = 'none';
        }
    });

    const badge = document.getElementById('historyCountBadge');
    if (badge) {
        badge.textContent = `${visibleCount} Records`;
    }
}

function clearHistoryFilters() {
    const ids = ['historySemFilter', 'historyBranchFilter', 'historySectionFilter', 'historySubjectFilter', 'historyDateFilter', 'historySearchInput'];
    ids.forEach(function(id) {
        const el = document.getElementById(id);
        if (el) el.value = '';
    });
    applyHistoryFilters();
}

/* =========================================================
   MANUAL ATTENDANCE VERIFICATION JAVASCRIPT
========================================================= */
function filterVerif(category) {
    document.querySelectorAll('.filter-verif-btn').forEach(btn => btn.classList.replace('btn-primary', 'btn-outline-secondary'));
    const btnMap = { 'all': 'btnVerifAll', 'low_conf': 'btnVerifLow', 'absent': 'btnVerifAbsent', 'pending': 'btnVerifPending' };
    if (btnMap[category] && document.getElementById(btnMap[category])) {
        document.getElementById(btnMap[category]).classList.replace('btn-outline-secondary', 'btn-primary');
    }

    const rows = document.querySelectorAll('#verifTable tbody tr');
    let visibleCount = 0;
    rows.forEach(function(row) {
        const status = (row.dataset.status || '').toLowerCase();
        const conf = parseFloat(row.dataset.confidence || '0');
        const verified = row.dataset.verified === 'true';

        let show = true;
        if (category === 'low_conf') show = conf < 80;
        else if (category === 'absent') show = status === 'absent';
        else if (category === 'pending') show = !verified;

        row.style.display = show ? '' : 'none';
        if (show) visibleCount++;
    });

    const badge = document.getElementById('verifyCountBadge');
    if (badge) badge.textContent = `${visibleCount} Candidates for Review`;
}

function setVerifStatus(id, newStatus) {
    const row = document.getElementById(`verifRow_${id}`);
    const badge = document.getElementById(`verifBadge_${id}`);
    if (!row || !badge) return;

    const studentName = row.dataset.name || 'this student';
    if (!confirm(`Are you sure you want to mark ${studentName} as ${newStatus.toUpperCase()}?`)) {
        return;
    }

    row.dataset.status = newStatus;
    row.dataset.verified = 'true';

    if (newStatus === 'present') {
        badge.className = 'verif-badge status-present';
        badge.innerHTML = '<i class="bi bi-check-circle-fill"></i> Present (Verified)';
    } else {
        badge.className = 'verif-badge status-absent';
        badge.innerHTML = '<i class="bi bi-x-circle-fill"></i> Absent (Verified)';
    }

    row.style.backgroundColor = '#f8fafc';
    setTimeout(() => { row.style.backgroundColor = ''; }, 1000);
}

function verifyAllPresent() {
    if (!confirm('Are you sure you want to confirm all displayed candidate students as PRESENT?')) {
        return;
    }
    const rows = document.querySelectorAll('#verifTable tbody tr');
    rows.forEach(function(row) {
        const idParts = row.id.split('_');
        if (idParts.length === 2) {
            const badge = document.getElementById(`verifBadge_${idParts[1]}`);
            row.dataset.status = 'present';
            row.dataset.verified = 'true';
            if (badge) {
                badge.className = 'verif-badge status-present';
                badge.innerHTML = '<i class="bi bi-check-circle-fill"></i> Present (Verified)';
            }
        }
    });
}

function correctRecognition(id, currentName, currentRoll) {
    const newRoll = prompt(`Correction for student: ${currentName}\nCurrent USN: ${currentRoll}\nEnter corrected USN:`, currentRoll);
    if (newRoll && newRoll.trim() !== '') {
        if (!confirm(`Confirm assigning USN "${newRoll.trim().toUpperCase()}" to ${currentName} and marking as Present?`)) {
            return;
        }
        const rollEl = document.getElementById(`verifRoll_${id}`);
        if (rollEl) rollEl.textContent = newRoll.trim().toUpperCase();
        const row = document.getElementById(`verifRow_${id}`);
        const badge = document.getElementById(`verifBadge_${id}`);
        if (row) {
            row.dataset.status = 'present';
            row.dataset.verified = 'true';
        }
        if (badge) {
            badge.className = 'verif-badge status-present';
            badge.innerHTML = '<i class="bi bi-check-circle-fill"></i> Present (Verified)';
        }
    }
}

/* =========================================================
   REAL-TIME STUDENT EMAIL ATTENDANCE DISPATCH JAVASCRIPT
========================================================= */
const studentsDataset = {{ students_list|tojson if students_list else '[]' }};
let currentEmailMode = 'weekly'; // 'weekly', 'shortage', 'monthly'
let filteredStudentsForEmail = [];

function switchEmailMode(mode, btn) {
    currentEmailMode = mode;
    
    // Update active tab button style
    document.querySelectorAll('#studentEmailTabs .nav-link').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');

    const badge = document.getElementById('activeModeBadge');
    const dateLabel = document.getElementById('dateFilterLabel');
    const dateCol = document.getElementById('dateFilterCol');
    const subjInput = document.getElementById('emailSubjectInput');
    const msgInput = document.getElementById('emailMessageInput');

    if (mode === 'weekly') {
        if (badge) badge.textContent = 'Mode: Weekly Update';
        if (dateLabel) dateLabel.textContent = 'Week / Date';
        if (subjInput) subjInput.value = 'Weekly Attendance Update - 7th Semester CSE (AIML)';
        if (msgInput) msgInput.value = 'Please find your weekly attendance update. Keep attending classes regularly to stay on track with your coursework. If you have any doubts, feel free to meet me after class.';
    } else if (mode === 'shortage') {
        if (badge) badge.textContent = 'Mode: Low Attendance Warning';
        if (dateLabel) dateLabel.textContent = 'As of Date';
        if (subjInput) subjInput.value = 'Important Notice: Attendance Below 75% Requirement';
        if (msgInput) msgInput.value = 'Please note that your current attendance is below the required 75%. As per college regulations, at least 75% attendance is required to appear for final examinations. Kindly attend all upcoming classes regularly and meet me if you have any questions.';
    } else if (mode === 'monthly') {
        if (badge) badge.textContent = 'Mode: Monthly Summary';
        if (dateLabel) dateLabel.textContent = 'Month / Date';
        if (subjInput) subjInput.value = 'Monthly Attendance Summary - September 2026';
        if (msgInput) msgInput.value = 'Here is your attendance summary for this month. Please review your record and maintain regular attendance in all subjects.';
    }

    filterStudentsForEmail();
}

function filterStudentsForEmail() {
    const sem = document.getElementById('emailSemFilter')?.value || '';
    const branch = document.getElementById('emailBranchFilter')?.value || '';
    const sec = document.getElementById('emailSecFilter')?.value || '';

    filteredStudentsForEmail = studentsDataset.filter(function(s) {
        const matchSem = !sem || String(s.semester) === String(sem);
        const matchSec = !sec || String(s.section).toUpperCase() === String(sec).toUpperCase();
        const matchBranch = !branch || String(s.branch).toLowerCase().includes(branch.toLowerCase()) || String(branch).toLowerCase().includes(String(s.branch).toLowerCase());
        
        if (currentEmailMode === 'shortage') {
            return matchSem && matchSec && matchBranch && Number(s.percentage || 0) < 75;
        }
        return matchSem && matchSec && matchBranch;
    });

    renderStudentEmailTable(filteredStudentsForEmail);
}

function renderStudentEmailTable(students) {
    const tbody = document.getElementById('studentEmailSelectionTbody');
    if (!tbody) return;

    tbody.innerHTML = '';
    if (students.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted"><i class="bi bi-inbox fs-4 d-block mb-1"></i>No students found matching the selected filters.</td></tr>';
        updateSelectedCount();
        return;
    }

    students.forEach(function(s) {
        const tr = document.createElement('tr');
        const pct = Number(s.percentage || 0);
        const isShortage = pct < 75.0;
        const badgeClass = isShortage ? 'bg-danger-subtle text-danger border border-danger-subtle' : 'bg-success-subtle text-success border border-success-subtle';
        const statusText = isShortage ? 'Low Attendance (<75%)' : 'Regular (≥75%)';
        const pctColor = isShortage ? '#dc2626' : '#16a34a';

        tr.innerHTML = `
            <td>
                <input type="checkbox" class="form-check-input student-select-cb" value="${s.student_id}" data-usn="${s.roll_no}" data-email="${s.email}" data-name="${s.name}" data-pct="${pct}" onchange="updateSelectedCount()" checked>
            </td>
            <td>
                <div class="d-flex align-items-center gap-2">
                    <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.78rem;">
                        ${(s.name || 'S').charAt(0).toUpperCase()}
                    </div>
                    <span class="fw-semibold text-dark">${s.name}</span>
                </div>
            </td>
            <td><span class="badge bg-light text-primary border fw-semibold">${s.roll_no}</span></td>
            <td>
                ${s.email && s.email !== 'N/A' 
                    ? `<span class="text-dark small"><i class="bi bi-envelope me-1 text-muted"></i>${s.email}</span>` 
                    : '<span class="badge bg-warning-subtle text-warning"><i class="bi bi-exclamation-circle me-1"></i>No Email</span>'}
            </td>
            <td><span class="fw-semibold">${s.attended_count || 0}</span> / <span class="text-muted">${s.total_sessions || 0}</span></td>
            <td><strong style="color: ${pctColor};">${pct}%</strong></td>
            <td><span class="badge ${badgeClass} px-2 py-1">${statusText}</span></td>
        `;
        tbody.appendChild(tr);
    });

    updateSelectedCount();
}

function updateSelectedCount() {
    const checkboxes = document.querySelectorAll('.student-select-cb:checked');
    const count = checkboxes.length;
    
    const countBadge = document.getElementById('selectedCountBadge');
    const btnCount = document.getElementById('btnSelectedCount');
    const btnSend = document.getElementById('btnSendStudentEmails');

    if (countBadge) countBadge.textContent = `${count} Students Selected`;
    if (btnCount) btnCount.textContent = count;
    if (btnSend) btnSend.disabled = (count === 0);

    const selectAllCb = document.getElementById('selectAllCheckbox');
    const totalCb = document.querySelectorAll('.student-select-cb');
    if (selectAllCb && totalCb.length > 0) {
        selectAllCb.checked = (count === totalCb.length);
    }
}

function toggleSelectAllCheckbox(source) {
    const checkboxes = document.querySelectorAll('.student-select-cb');
    checkboxes.forEach(cb => cb.checked = source.checked);
    updateSelectedCount();
}

function selectAllStudents(checked) {
    const checkboxes = document.querySelectorAll('.student-select-cb');
    checkboxes.forEach(cb => cb.checked = checked);
    const selectAllCb = document.getElementById('selectAllCheckbox');
    if (selectAllCb) selectAllCb.checked = checked;
    updateSelectedCount();
}

function selectLowAttendanceStudentsOnly() {
    const checkboxes = document.querySelectorAll('.student-select-cb');
    checkboxes.forEach(cb => {
        const pct = parseFloat(cb.getAttribute('data-pct') || '0');
        cb.checked = (pct < 75.0);
    });
    updateSelectedCount();
}

function previewSampleStudentEmail() {
    const checked = document.querySelector('.student-select-cb:checked');
    let sampleStudent = null;
    if (checked) {
        sampleStudent = {
            name: checked.getAttribute('data-name'),
            usn: checked.getAttribute('data-usn'),
            email: checked.getAttribute('data-email'),
            pct: checked.getAttribute('data-pct')
        };
    } else if (filteredStudentsForEmail.length > 0) {
        sampleStudent = {
            name: filteredStudentsForEmail[0].name,
            usn: filteredStudentsForEmail[0].roll_no,
            email: filteredStudentsForEmail[0].email,
            pct: filteredStudentsForEmail[0].percentage
        };
    }

    if (!sampleStudent) {
        alert('Please select at least one student to preview.');
        return;
    }

    const toEl = document.getElementById('modalPreviewToEmail');
    const subjEl = document.getElementById('modalPreviewSubject');
    const headerTitleEl = document.getElementById('modalPreviewHeaderTitle');
    const greetingEl = document.getElementById('modalPreviewGreeting');
    const pctEl = document.getElementById('modalPreviewPct');
    const statusNoteEl = document.getElementById('modalPreviewStatusNote');
    const teacherNoteEl = document.getElementById('modalPreviewTeacherNote');

    const subj = document.getElementById('emailSubjectInput')?.value || 'Attendance Notification';
    const note = document.getElementById('emailMessageInput')?.value || '';

    if (toEl) toEl.textContent = sampleStudent.email || 'student@gsss.edu.in';
    if (subjEl) subjEl.textContent = subj;
    if (teacherNoteEl) teacherNoteEl.textContent = note || 'Please attend all scheduled classes.';

    const pctVal = parseFloat(sampleStudent.pct || '0');
    if (pctEl) {
        pctEl.textContent = `${pctVal}%`;
        pctEl.style.color = pctVal >= 75 ? '#16a34a' : '#dc2626';
    }

    if (currentEmailMode === 'shortage') {
        if (headerTitleEl) headerTitleEl.textContent = 'Important Attendance Notice';
        if (greetingEl) greetingEl.innerHTML = `Dear <strong>${sampleStudent.name}</strong>,<br>This is an important notice regarding your current attendance for 7th Semester - CSE (AIML).`;
        if (statusNoteEl) {
            statusNoteEl.className = 'alert alert-danger border small mb-3';
            statusNoteEl.innerHTML = '<strong>Notice:</strong> Your current attendance is below the required 75%. Please ensure you attend all upcoming classes regularly.';
        }
    } else if (currentEmailMode === 'weekly') {
        if (headerTitleEl) headerTitleEl.textContent = 'Weekly Attendance Update';
        if (greetingEl) greetingEl.innerHTML = `Dear <strong>${sampleStudent.name}</strong>,<br>Here is your weekly verified attendance update for 7th Semester - CSE (AIML).`;
        if (statusNoteEl) {
            statusNoteEl.className = 'alert alert-info border small mb-3';
            statusNoteEl.innerHTML = 'Summary of classroom sessions attended during this week.';
        }
    } else {
        if (headerTitleEl) headerTitleEl.textContent = 'Monthly Attendance Summary';
        if (greetingEl) greetingEl.innerHTML = `Dear <strong>${sampleStudent.name}</strong>,<br>Here is your official monthly attendance report.`;
        if (statusNoteEl) {
            statusNoteEl.className = 'alert alert-light border small mb-3';
            statusNoteEl.innerHTML = 'Please review your monthly attendance report and maintain consistent attendance.';
        }
    }

    const modalEl = document.getElementById('modalEmailPreview');
    if (modalEl && typeof bootstrap !== 'undefined') {
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
    }
}

async function dispatchStudentEmailsRealtime() {
    const checkedBoxes = Array.from(document.querySelectorAll('.student-select-cb:checked'));
    if (checkedBoxes.length === 0) {
        alert('Please select at least one student.');
        return;
    }

    const studentIds = checkedBoxes.map(cb => parseInt(cb.value, 10));
    const subject = document.getElementById('emailSubjectInput')?.value || '';
    const customMessage = document.getElementById('emailMessageInput')?.value || '';
    const subjectName = document.getElementById('emailSubFilter')?.value || 'All Subjects';

    const confirmMsg = `Send real-time attendance email to ${studentIds.length} selected student(s)?`;
    if (!confirm(confirmMsg)) return;

    // Show Progress Block
    const auditBlock = document.getElementById('emailDispatchAuditBlock');
    const progressBar = document.getElementById('emailProgressBar');
    const resultsList = document.getElementById('emailDispatchResultsList');
    const statusBadge = document.getElementById('dispatchStatusBadge');
    const btnSend = document.getElementById('btnSendStudentEmails');

    if (auditBlock) auditBlock.classList.remove('d-none');
    if (resultsList) resultsList.innerHTML = '';
    if (progressBar) {
        progressBar.style.width = '25%';
        progressBar.className = 'progress-bar progress-bar-striped progress-bar-animated bg-primary';
    }
    if (statusBadge) {
        statusBadge.className = 'badge bg-warning rounded-pill px-3 py-2';
        statusBadge.textContent = 'Dispatching Emails...';
    }
    if (btnSend) btnSend.disabled = true;

    auditBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });

    try {
        const response = await fetch('/teacher/email/dispatch-students', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({
                report_type: currentEmailMode,
                student_ids: studentIds,
                subject: subject,
                custom_message: customMessage,
                subject_name: subjectName,
                period_label: currentEmailMode === 'weekly' ? 'Current Week' : 'September 2026'
            })
        });

        const data = await response.json();

        if (progressBar) progressBar.style.width = '100%';

        if (data.success) {
            if (statusBadge) {
                statusBadge.className = 'badge bg-success rounded-pill px-3 py-2';
                statusBadge.textContent = `Completed (${data.delivered_count} Sent)`;
            }

            if (resultsList && data.results) {
                data.results.forEach(function(r) {
                    const row = document.createElement('div');
                    row.className = 'd-flex justify-content-between align-items-center py-1 border-bottom';
                    
                    const isSuccess = r.status === 'sent' || r.status === 'logged';
                    const iconClass = isSuccess ? 'bi bi-check-circle-fill text-success' : 'bi bi-x-circle-fill text-danger';
                    const badgeClass = isSuccess ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger';
                    const label = r.status === 'sent' ? 'Sent (SMTP)' : (r.status === 'logged' ? 'Dispatched (Spool)' : 'Skipped');

                    row.innerHTML = `
                        <div>
                            <i class="${iconClass} me-1"></i>
                            <strong>${r.name}</strong> (${r.usn})
                            <span class="text-muted ms-1">&lt;${r.email}&gt;</span>
                            <span class="badge bg-light text-dark border ms-1">${r.percentage}%</span>
                        </div>
                        <span class="badge ${badgeClass} px-2 py-1">${label}</span>
                    `;
                    resultsList.appendChild(row);
                });
            }

            // Also dynamically add to notification center
            addDispatchNotification(data.delivered_count, currentEmailMode);

        } else {
            if (statusBadge) {
                statusBadge.className = 'badge bg-danger rounded-pill px-3 py-2';
                statusBadge.textContent = 'Dispatch Failed';
            }
            if (resultsList) {
                resultsList.innerHTML = `<div class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i>${data.error || 'Failed to dispatch emails.'}</div>`;
            }
        }
    } catch (err) {
        if (statusBadge) {
            statusBadge.className = 'badge bg-danger rounded-pill px-3 py-2';
            statusBadge.textContent = 'Network Error';
        }
        if (resultsList) {
            resultsList.innerHTML = `<div class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>Error: ${err.message}</div>`;
        }
    } finally {
        if (btnSend) btnSend.disabled = false;
    }
}

function addDispatchNotification(count, mode) {
    const listGroup = document.getElementById('notificationsListGroup');
    if (!listGroup) return;

    const notifItem = document.createElement('div');
    notifItem.className = 'list-group-item p-3 d-flex justify-content-between align-items-start gap-3 notif-item bg-light';
    notifItem.setAttribute('data-type', 'verification');
    notifItem.setAttribute('data-read', 'false');

    const modeName = mode === 'shortage' ? 'Low Attendance Warning' : (mode === 'weekly' ? 'Weekly Attendance' : 'Monthly Attendance');

    notifItem.innerHTML = `
        <div class="d-flex gap-3">
            <div class="p-2 rounded-circle bg-success-subtle text-success" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-envelope-check-fill"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold text-dark">Real-Time Student Emails Sent</span>
                    <span class="badge bg-success-subtle text-success small">${count} Delivered</span>
                    <span class="badge bg-danger rounded-pill" style="font-size: 0.65rem;">NEW</span>
                </div>
                <div class="text-muted small mt-1">Successfully dispatched ${modeName} notifications to ${count} students.</div>
                <div class="text-muted" style="font-size: 0.72rem; margin-top: 4px;">Just now</div>
            </div>
        </div>
    `;

    listGroup.insertBefore(notifItem, listGroup.firstChild);
    if (typeof updateNotifBadges === 'function') {
        updateNotifBadges();
    }
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
    filterStudentsForEmail();
});


/* =========================================================
   NOTIFICATION CENTER JAVASCRIPT
========================================================= */
function openNotificationsTab() {
    const notifBtn = document.querySelector('.teacher-menu-link[data-section="notificationsSection"]');
    if (notifBtn) notifBtn.click();
}

function filterNotifs(type) {
    document.querySelectorAll('.filter-notif-btn').forEach(btn => btn.classList.replace('btn-primary', 'btn-outline-secondary'));
    const btnMap = { 'all': 'btnNotifAll', 'shortage': 'btnNotifShortage', 'processing': 'btnNotifProcessing', 'verification': 'btnNotifVerification' };
    if (btnMap[type] && document.getElementById(btnMap[type])) {
        document.getElementById(btnMap[type]).classList.replace('btn-outline-secondary', 'btn-primary');
    }

    const items = document.querySelectorAll('#notificationsListGroup .notif-item');
    items.forEach(function(item) {
        const itemType = item.dataset.type;
        item.style.display = (type === 'all' || itemType === type) ? '' : 'none';
    });
}

function markNotifAsRead(id) {
    const item = document.getElementById(`notif_${id}`);
    const dot = document.getElementById(`unreadDot_${id}`);
    if (dot) dot.remove();
    if (item) {
        item.classList.remove('bg-light');
        item.dataset.read = 'true';
    }
    updateNotifBadges();
}

function markAllNotifsAsRead() {
    document.querySelectorAll('#notificationsListGroup .notif-item').forEach(item => {
        item.classList.remove('bg-light');
        item.dataset.read = 'true';
    });
    document.querySelectorAll('#notificationsListGroup [id^="unreadDot_"]').forEach(dot => dot.remove());
    updateNotifBadges();
}

function updateNotifBadges() {
    const unreadCount = document.querySelectorAll('#notificationsListGroup .notif-item[data-read="false"]').length;
    const centerBadge = document.getElementById('notifCenterBadge');
    const sideBadge = document.getElementById('sidebarNotifBadge');
    const topBadge = document.getElementById('topbarNotifBadge');

    if (centerBadge) centerBadge.textContent = `${unreadCount} Unread Alerts`;
    if (sideBadge) {
        sideBadge.textContent = unreadCount;
        sideBadge.style.display = unreadCount === 0 ? 'none' : '';
    }
    if (topBadge) {
        topBadge.textContent = unreadCount;
        topBadge.style.display = unreadCount === 0 ? 'none' : '';
    }
}

/* =========================================================
   CHART.JS ATTENDANCE ANALYTICS INITIALIZATION
========================================================= */
let chartsInitialized = false;

function initAnalyticsCharts() {
    if (typeof Chart === 'undefined') return;
    if (chartsInitialized) return;

    const analyticsData = {
        presentCount: {{ analytics_data.present_count if analytics_data else 0 }},
        absentCount: {{ analytics_data.absent_count if analytics_data else 0 }},
        tierHigh: {{ analytics_data.tier_high if analytics_data else 0 }},
        tierMid: {{ analytics_data.tier_mid if analytics_data else 0 }},
        tierLow: {{ analytics_data.tier_low if analytics_data else 0 }},
        trendLabels: {{ analytics_data.trend_labels|tojson if analytics_data and analytics_data.trend_labels else [] }},
        trendCounts: {{ analytics_data.trend_counts|tojson if analytics_data and analytics_data.trend_counts else [] }},
        subjectLabels: {{ analytics_data.subject_labels|tojson if analytics_data and analytics_data.subject_labels else [] }},
        subjectCounts: {{ analytics_data.subject_counts|tojson if analytics_data and analytics_data.subject_counts else [] }},
        branchName: "{{ analytics_data.branch_name if analytics_data else 'CSE (AIML)' }}",
        branchCount: {{ analytics_data.branch_count if analytics_data else 0 }}
    };

    // 1. Present vs Absent Donut Chart
    const ctx1 = document.getElementById('chartPresentAbsent');
    if (ctx1) {
        new Chart(ctx1, {
            type: 'doughnut',
            data: {
                labels: ['Present', 'Absent'],
                datasets: [{
                    data: [analyticsData.presentCount, analyticsData.absentCount],
                    backgroundColor: ['#10b981', '#ef4444'],
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 14, font: { family: 'Poppins' } } }
                },
                cutout: '70%'
            }
        });
    }

    // 2. Performance Tiers Pie Chart
    const ctx2 = document.getElementById('chartTiers');
    if (ctx2) {
        new Chart(ctx2, {
            type: 'pie',
            data: {
                labels: ['Regular (≥75%)', 'Average (50-74%)', 'At-Risk (<50%)'],
                datasets: [{
                    data: [analyticsData.tierHigh, analyticsData.tierMid, analyticsData.tierLow],
                    backgroundColor: ['#059669', '#f59e0b', '#dc2626'],
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 14, font: { family: 'Poppins' } } }
                }
            }
        });
    }

    // 3. Attendance Trend Over Time Line/Area Chart
    const ctx3 = document.getElementById('chartTrend');
    if (ctx3) {
        new Chart(ctx3, {
            type: 'line',
            data: {
                labels: analyticsData.trendLabels.length ? analyticsData.trendLabels : ['25 Aug', '29 Aug', '31 Aug', '01 Sep', '02 Sep', '03 Sep'],
                datasets: [{
                    label: 'Students Present',
                    data: analyticsData.trendCounts.length ? analyticsData.trendCounts : [2, 21, 18, 37, 167, 176],
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59, 130, 246, 0.12)',
                    fill: true,
                    tension: 0.35,
                    pointBackgroundColor: '#2563eb',
                    pointRadius: 5,
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { font: { family: 'Poppins' } } },
                    x: { grid: { display: false }, ticks: { font: { family: 'Poppins' } } }
                }
            }
        });
    }

    // 4. Subject-Wise Attendance Bar Chart
    const ctx4 = document.getElementById('chartSubjects');
    if (ctx4) {
        new Chart(ctx4, {
            type: 'bar',
            data: {
                labels: analyticsData.subjectLabels.length ? analyticsData.subjectLabels : ['DBMS', 'Algorithms', 'Major Project', 'NLP', 'IoT', 'Prog Verif'],
                datasets: [{
                    label: 'Present Count',
                    data: analyticsData.subjectCounts.length ? analyticsData.subjectCounts : [59, 51, 49, 44, 41, 40],
                    backgroundColor: '#8b5cf6',
                    borderRadius: 6
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                    y: { grid: { display: false }, ticks: { font: { size: 11, family: 'Poppins' } } }
                }
            }
        });
    }

    // 5. Branch & Section Comparison Bar Chart
    const ctx5 = document.getElementById('chartBranch');
    if (ctx5) {
        new Chart(ctx5, {
            type: 'bar',
            data: {
                labels: ['CSE (AIML) - Sec A', 'CSE - Sec A', 'CSE (AIDS) - Sec A', 'ECE - Sec A', 'IS - Sec A'],
                datasets: [{
                    label: 'Present Attendance Recorded',
                    data: [analyticsData.branchCount, 0, 0, 0, 0],
                    backgroundColor: ['#3b82f6', '#cbd5e1', '#cbd5e1', '#cbd5e1', '#cbd5e1'],
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    chartsInitialized = true;
}

/* =========================================================
   NAVIGATION & INTERACTIONS
========================================================= */
document.addEventListener("DOMContentLoaded", function() {
    const sidebar = document.getElementById("teacherSidebar");
    const mobileButton = document.getElementById("mobileSidebarButton");
    const backdrop = document.getElementById("sidebarBackdrop");
    const menuLinks = document.querySelectorAll(".teacher-menu-link[data-section]");
    const sections = document.querySelectorAll(".dashboard-section");

    const pageTitle = document.getElementById('pageTitle');
    const pageSubtitle = document.getElementById('pageSubtitle');
    const teacherName = '{{ name or session.get('name') or 'Teacher' }}';

    // Current Date
    const dateEl = document.getElementById("currentDate");
    if (dateEl) {
        const now = new Date();
        dateEl.textContent = now.toLocaleDateString("en-IN", {
            day: "2-digit",
            month: "short",
            year: "numeric"
        });
    }

    // Tab Navigation
    menuLinks.forEach(function(link) {
        link.addEventListener("click", function() {
            const targetId = this.dataset.section;

            menuLinks.forEach(item => item.classList.remove("active"));
            this.classList.add("active");

            sections.forEach(sec => sec.classList.add("d-none"));
            const target = document.getElementById(targetId);
            if (target) {
                target.classList.remove("d-none");
                window.scrollTo({ top: 0, behavior: "smooth" });
            }

            const titleMap = {
                "dashboardSection": ["Dashboard", "Welcome, " + teacherName + ". Manage classroom video attendance and student records."],
                "studentsSection": ["Students Directory", "Browse and filter registered students across branches and sections."],
                "verificationSection": ["Manual Attendance Verification", "Review and verify low-confidence recognitions, unknown faces, and flagged records."],
                "aiAnalysisSection": ["AI Attendance Analysis", "Computer vision metrics, frame quality scoring, unknown face safeguards, and predictive analytics."],
                "analyticsSection": ["Attendance Analytics", "Classroom attendance distributions and longitudinal trends."],
                "historySection": ["Attendance History", "Chronological record of all historical attendance entries."],
                "processingHistorySection": ["Processing History", "Chronological archive of classroom videos processed by the AI system."],
                "exportSection": ["Export Reports", "Download attendance records as Excel or PDF documents."],
                "emailSection": ["Email Attendance Dispatch", "Generate and deliver verified classroom attendance reports directly to your registered email."],
                "notificationsSection": ["Notification Center", "Real-time alerts, processing confirmations, and attendance shortages."],
                "profileSection": ["Teacher Profile", "Your account information and role credentials."]
            };

            if (titleMap[targetId] && pageTitle && pageSubtitle) {
                pageTitle.textContent = titleMap[targetId][0];
                pageSubtitle.textContent = titleMap[targetId][1];
            }

            if (targetId === "analyticsSection") {
                setTimeout(initAnalyticsCharts, 100);
            }

            if (sidebar) sidebar.classList.remove("open");
            if (backdrop) backdrop.classList.remove("active");
        });
    });

    // Mobile Drawer Toggle
    if (mobileButton && sidebar) {
        mobileButton.addEventListener("click", function() {
            sidebar.classList.toggle("open");
            if (backdrop) backdrop.classList.toggle("active");
        });
    }

    if (backdrop && sidebar) {
        backdrop.addEventListener("click", function() {
            sidebar.classList.remove("open");
            backdrop.classList.remove("active");
        });
    }

    // Attach student filter listeners
    const btnFilter = document.getElementById('btnFilterStudents');
    const btnView = document.getElementById('btnViewAllStudents');
    const studentSearch = document.getElementById('studentSearchInput');
    const studentBranch = document.getElementById('studentBranchFilter');
    const studentSection = document.getElementById('studentSectionFilter');

    if (btnFilter) btnFilter.addEventListener('click', applyStudentFilters);
    if (btnView) btnView.addEventListener('click', viewAllStudents);
    if (studentSearch) studentSearch.addEventListener('input', applyStudentFilters);
    if (studentBranch) studentBranch.addEventListener('change', applyStudentFilters);
    if (studentSection) studentSection.addEventListener('change', applyStudentFilters);

    // Attach history filter listeners
    const histIds = ['historySemFilter', 'historyBranchFilter', 'historySectionFilter', 'historySubjectFilter', 'historyDateFilter'];
    histIds.forEach(function(id) {
        const el = document.getElementById(id);
        if (el) el.addEventListener('change', applyHistoryFilters);
    });
    const histSearch = document.getElementById('historySearchInput');
    if (histSearch) histSearch.addEventListener('input', applyHistoryFilters);

    // Dynamic Class -> Subject Loading
    const classSelect = document.getElementById("class_id");
    const subjectSelect = document.getElementById("subject_id");
    const videoInput = document.getElementById("video");
    const videoInfo = document.getElementById("videoInfo");
    const uploadForm = document.getElementById("videoUploadForm");
    const uploadButton = document.getElementById("uploadButton");

    function checkForm() {
        const classOk = classSelect && classSelect.value !== "";
        const subjectOk = subjectSelect && subjectSelect.value !== "";
        const videoOk = videoInput && videoInput.files && videoInput.files.length > 0;
        if (uploadButton) {
            uploadButton.disabled = !(classOk && subjectOk && videoOk);
        }
    }

    if (classSelect && subjectSelect) {
        classSelect.addEventListener("change", async function() {
            const classId = this.value;
            subjectSelect.innerHTML = '<option value="">Loading subjects...</option>';
            subjectSelect.disabled = true;
            if (uploadButton) uploadButton.disabled = true;

            if (!classId) {
                subjectSelect.innerHTML = '<option value="">Select class first</option>';
                return;
            }

            try {
                const url = "{{ url_for('teacher.subjects_by_class', class_id=0) }}".replace("/0", "/" + classId);
                const res = await fetch(url);
                if (!res.ok) throw new Error("HTTP error " + res.status);
                const subjects = await res.json();
                subjectSelect.innerHTML = '<option value="">Select subject</option>';
                if (!subjects || subjects.length === 0) {
                    subjectSelect.innerHTML = '<option value="">No subjects found for this class</option>';
                    subjectSelect.disabled = true;
                    return;
                }
                subjects.forEach(function(sub) {
                    const opt = document.createElement("option");
                    opt.value = sub.subject_id;
                    opt.textContent = sub.subject_name + (sub.subject_code ? " (" + sub.subject_code + ")" : "");
                    subjectSelect.appendChild(opt);
                });
                subjectSelect.disabled = false;
            } catch (err) {
                console.error("Subject load failed:", err);
                subjectSelect.innerHTML = '<option value="">Error loading subjects</option>';
                subjectSelect.disabled = true;
            }
            checkForm();
        });

        subjectSelect.addEventListener("change", checkForm);
    }

    if (videoInput) {
        videoInput.addEventListener("change", function() {
            const file = this.files[0];
            if (!file) {
                if (videoInfo) videoInfo.classList.add("d-none");
                checkForm();
                return;
            }
            const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
            if (videoInfo) {
                videoInfo.innerHTML = '<i class="bi bi-info-circle me-1 text-primary"></i> <strong>Selected Video:</strong> ' +
                    file.name + ' &nbsp;|&nbsp; <strong>Size:</strong> ' + sizeMB + ' MB';
                videoInfo.classList.remove("d-none");
            }
            checkForm();
        });
    }

    if (uploadForm && uploadButton) {
        uploadForm.addEventListener("submit", function() {
            uploadButton.disabled = true;
            uploadButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Uploading...';
            const statusDiv = document.getElementById('uploadStatus');
            if (statusDiv) {
                statusDiv.className = 'alert alert-info d-flex align-items-center gap-2';
                statusDiv.innerHTML = '<span class="spinner-border spinner-border-sm"></span> <div>Uploading video. Processing will begin in background...</div>';
                statusDiv.classList.remove('d-none');
            }
        });
    }
});
</script>
{% endblock %}
